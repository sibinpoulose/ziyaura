<%- include("partials/header") %>

  <div style="display:flex; justify-content:center; align-items:center; min-height:85vh; background:#f3f3f3;">

    <div style="
    width:420px;
    background:#fff;
    padding:40px;
    border-radius:14px;
    box-shadow:0 0 12px rgba(0,0,0,0.08);
  ">

      <h2 style="margin-bottom:20px; color:#555;">Signup</h2>

      <form action="/signup" method="POST">

        <!-- Username -->
        <label style="font-size:14px;">Username</label>
        <input name="name" placeholder="username"
          style="width:100%; padding:12px; margin:8px 0 15px; border:1px solid #ddd; border-radius:8px;" required />

        <!-- Email -->
        <label style="font-size:14px;">Email</label>
        <input type="email" name="email" placeholder="example@email.com"
          style="width:100%; padding:12px; margin:8px 0 15px; border:1px solid #ddd; border-radius:8px;" required />

        <!-- Password -->
        <label style="font-size:14px;">Password</label>
        <input type="password" name="password" placeholder="Enter your password"
          style="width:100%; padding:12px; margin:8px 0 15px; border:1px solid #ddd; border-radius:8px;" required />

        <!-- Confirm Password -->
        <label style="font-size:14px;">Confirm Password</label>
        <input type="password" name="confirmPassword" placeholder="Enter your password"
          style="width:100%; padding:12px; margin:8px 0 15px; border:1px solid #ddd; border-radius:8px;" required />

        <!-- Phone -->
        <label style="font-size:14px;">Phone Number (Optional)</label>
        <input name="phone" placeholder="Enter your phone number"
          style="width:100%; padding:12px; margin:8px 0 20px; border:1px solid #ddd; border-radius:8px;" />

        <!-- Button -->
        <button style="
        width:100%;
        padding:14px;
        background:#5a67d8;
        color:#fff;
        border:none;
        border-radius:8px;
        font-weight:bold;
        cursor:pointer;
      ">
          Signup
        </button>

      </form>

      <!-- Error -->
      <p style="color:red; margin-top:10px;">
        <%= message || "" %>
      </p>

      <!-- Login link -->
      <div style="text-align:center; margin-top:15px;">
        Already have an account?
        <a href="/login" style="color:#5a67d8;">Login Now</a>
      </div>

      <!-- Divider -->
      <div style="text-align:center; margin:15px 0; color:#aaa;">or</div>

      <!-- Google -->
      <button style="
      width:100%;
      padding:12px;
      background:#eee;
      border:none;
      border-radius:8px;
      cursor:pointer;
    ">
        Continue with Google
      </button>

    </div>

  </div>

  <%- include("partials/footer") %>