<!DOCTYPE html>
<html>

<head>
    <title>Forgot Password</title>
    <style>
        body {
            font-family: Arial;
            background: #f2f2f2;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .box {
            background: #ddd;
            padding: 40px;
            border-radius: 10px;
            text-align: center;
            width: 400px;
        }

        h2 {
            margin-bottom: 10px;
        }

        input {
            width: 100%;
            padding: 12px;
            border-radius: 10px;
            border: 1px solid #ccc;
            margin-top: 20px;
        }

        button {
            margin-top: 20px;
            padding: 12px;
            width: 100%;
            border: none;
            border-radius: 10px;
            background: #5a67d8;
            color: white;
            font-size: 16px;
            cursor: pointer;
        }

        p {
            margin-top: 10px;
            color: red;
        }
    </style>
</head>

<body>
    <div class="box">
        <h2>Forgot Password</h2>
        <p>Enter your email to receive OTP</p>

        <form action="/forgot-password" method="POST">
            <input type="email" name="email" placeholder="Enter your email" required />
            <button type="submit">Send OTP</button>
        </form>

        <p>
            <%= message %>
        </p>
    </div>
</body>

</html>