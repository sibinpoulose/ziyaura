<!DOCTYPE html>
<html>
<head>
  <title>Ziyaura - Home</title>

  <style>
    body {
      margin: 0;
      font-family: Arial;
      background: #f5f5f5;
    }

    .hero {
      width: 90%;
      margin: 30px auto;
    }

    .hero img {
      width: 100%;
      border-radius: 5px;
    }

    .categories {
      display: flex;
      justify-content: center;
      gap: 20px;
      margin: 30px;
    }

    .category {
      text-align: center;
    }

    .category img {
      width: 200px;
      height: 200px;
      object-fit: cover;
      border-radius: 5px;
    }

    .section {
      width: 90%;
      margin: 40px auto;
    }

    .section img {
      width: 100%;
      border-radius: 5px;
    }

    .products {
      display: flex;
      justify-content: center;
      gap: 20px;
      margin: 40px;
    }

    .product {
      text-align: center;
    }

    .product img {
      width: 200px;
      height: 200px;
      object-fit: cover;
    }
  </style>
</head>

<body>

  <!-- 🔥 HEADER PARTIAL -->
  <%- include("partials/header") %>

  <!-- HERO -->
  <div class="hero">
    <img src="https://images.unsplash.com/photo-1612423284934-2850a4ea6b0f" />
  </div>

  <!-- CATEGORIES -->
  <div class="categories">

    <div class="category">
      <img src="https://images.unsplash.com/photo-1605100804763-247f67b3557e" />
      <p>RINGS</p>
    </div>

    <div class="category">
      <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f" />
      <p>CHAINS</p>
    </div>

    <div class="category">
      <img src="https://images.unsplash.com/photo-1617038220319-276d3cfab638?w=500" />
      <p>BRACELETS</p>
    </div>

    <div class="category">
      <img src="https://source.unsplash.com/500x500/?earring,jewelry" />
      <p>EARRINGS</p>
    </div>

  </div>

  <!-- SECTION -->
  <div class="section">
    <img src="https://images.unsplash.com/photo-1617038220319-276d3cfab638">
  </div>

  <!-- PRODUCTS -->
  <div class="products">

    <div class="product">
      <img src="https://images.unsplash.com/photo-1612423284934-2850a4ea6b0f">
      <p>Silver Ring</p>
    </div>

    <div class="product">
      <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f">
      <p>Chain</p>
    </div>

    <div class="product">
      <img src="https://source.unsplash.com/500x500/?bracelet,jewelry" />
      <p>Bracelet</p>
    </div>

    <div class="product">
      <img src="https://images.unsplash.com/photo-1589987607627-1d2e3c6f0c2f">
      <p>Earring</p>
    </div>

  </div>

  <!-- 🔥 FOOTER PARTIAL -->
  <%- include("partials/footer") %>

</body>
</html>