<%- include("../partials/user/header") %>

<div class="bg-gray-100 min-h-screen py-10">
  <div class="max-w-7xl mx-auto px-4 md:px-6">
    <div class="flex flex-col lg:flex-row gap-8">
      
      <!-- Sidebar -->
      <%- include("../partials/user/sidebar") %>

      <!-- Main Content -->
      <div class="flex-grow lg:w-3/4">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 md:p-8">
          
          <!-- Header and Search -->
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
            <div>
              <h1 class="text-2xl font-bold tracking-tight text-gray-900">Order History</h1>
              <p class="text-xs text-gray-500 mt-1 uppercase tracking-widest">Track and manage your luxury purchases</p>
            </div>
            
            <!-- Search Bar -->
            <form action="/profile/orders" method="GET" class="flex items-center w-full md:w-80 border border-gray-200 rounded-lg overflow-hidden focus-within:border-black transition-colors">
              <input 
                type="text" 
                name="search" 
                placeholder="Search Order ID or item..." 
                value="<%= search %>"
                class="w-full px-4 py-2.5 text-xs focus:outline-none"
              >
              <button type="submit" class="px-4 py-2.5 bg-gray-50 hover:bg-gray-100 text-gray-500 border-l border-gray-200 transition-colors">
                <i class="fa-solid fa-magnifying-glass text-xs"></i>
              </button>
            </form>
          </div>

          <!-- Active Search Query Clear Option -->
          <% if (search) { %>
            <div class="mb-6 flex items-center justify-between bg-gray-50 px-4 py-2.5 rounded-lg border border-gray-150 text-xs">
              <span class="text-gray-600 font-medium">
                Showing results for "<span class="font-bold text-black"><%= search %></span>"
              </span>
              <a href="/profile/orders" class="text-[10px] font-bold tracking-wider text-rose-600 hover:text-rose-800 uppercase flex items-center gap-1">
                Clear Search <i class="fa-solid fa-xmark"></i>
              </a>
            </div>
          <% } %>

          <!-- Orders List -->
          <% if (orders && orders.length > 0) { %>
            <div class="space-y-6">
              <% orders.forEach(order => { %>
                <div class="border border-gray-100 rounded-xl overflow-hidden hover:shadow-md transition-all duration-300 bg-white">
                  
                  <!-- Order Card Header -->
                  <div class="bg-gray-50/70 border-b border-gray-100 p-4 flex flex-wrap items-center justify-between gap-4 text-xs font-semibold text-gray-700">
                    <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
                      <div>
                        <span class="text-[9px] uppercase tracking-wider text-gray-400 block font-bold mb-0.5">Order Placed</span>
                        <span class="text-gray-800"><%= new Date(order.createdAt).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
                      </div>
                      <div>
                        <span class="text-[9px] uppercase tracking-wider text-gray-400 block font-bold mb-0.5">Total Amount</span>
                        <span class="text-gray-900 font-bold">₹<%= order.grandTotal.toLocaleString() %></span>
                      </div>
                      <div>
                        <span class="text-[9px] uppercase tracking-wider text-gray-400 block font-bold mb-0.5">Ship To</span>
                        <span class="text-gray-800"><%= order.shippingAddress.fullName %></span>
                      </div>
                    </div>
                    
                    <div class="flex items-center gap-3">
                      <span class="text-[9px] uppercase tracking-wider text-gray-400 block font-bold mb-0.5 text-right">Order ID</span>
                      <span class="text-black font-mono font-bold tracking-wider"><%= order.orderId %></span>
                    </div>
                  </div>

                  <!-- Order Card Body (Items list preview) -->
                  <div class="p-4 md:p-6 divide-y divide-gray-50">
                    <% order.products.forEach(item => { %>
                      <div class="flex items-center gap-4 py-4 first:pt-0 last:pb-0">
                        <div class="w-16 h-16 bg-gray-50 border border-gray-100 rounded-sm overflow-hidden flex-shrink-0 flex items-center justify-center">
                          <% if (item.image) { %>
                            <img src="<%= item.image %>" alt="<%= item.name %>" class="w-full h-full object-cover">
                          <% } else { %>
                            <i class="fa-regular fa-image text-gray-300 text-lg"></i>
                          <% } %>
                        </div>
                        
                        <div class="flex-grow min-w-0">
                          <h4 class="text-xs font-bold text-gray-900 truncate"><%= item.name %></h4>
                          <% if (item.variantDetails) { %>
                            <p class="text-[9px] text-gray-400 uppercase tracking-widest font-bold mt-0.5"><%= item.variantDetails %></p>
                          <% } %>
                          <p class="text-[10px] text-gray-500 mt-1 font-semibold">Qty: <%= item.quantity %> &bull; Price: ₹<%= item.price.toLocaleString() %></p>
                        </div>
                        
                        <!-- Status Column per Product -->
                        <div class="text-right flex-shrink-0 min-w-[100px]">
                          <% if (item.orderStatus === 'Cancelled') { %>
                            <span class="inline-block text-[8px] font-bold tracking-widest text-rose-600 bg-rose-50 border border-rose-100 px-2 py-0.5 rounded-full uppercase">Cancelled</span>
                          <% } else if (item.orderStatus === 'Returned') { %>
                            <span class="inline-block text-[8px] font-bold tracking-widest text-purple-600 bg-purple-50 border border-purple-100 px-2 py-0.5 rounded-full uppercase">Returned</span>
                          <% } else if (item.orderStatus === 'Delivered') { %>
                            <span class="inline-block text-[8px] font-bold tracking-widest text-emerald-600 bg-emerald-50 border border-emerald-100 px-2 py-0.5 rounded-full uppercase">Delivered</span>
                          <% } else if (item.orderStatus === 'Shipped') { %>
                            <span class="inline-block text-[8px] font-bold tracking-widest text-blue-600 bg-blue-50 border border-blue-100 px-2 py-0.5 rounded-full uppercase">Shipped</span>
                          <% } else { %>
                            <span class="inline-block text-[8px] font-bold tracking-widest text-amber-600 bg-amber-50 border border-amber-100 px-2 py-0.5 rounded-full uppercase"><%= item.orderStatus %></span>
                          <% } %>
                        </div>
                      </div>
                    <% }); %>
                  </div>

                  <!-- Order Card Footer (Actions) -->
                  <div class="bg-gray-50/40 border-t border-gray-100 px-6 py-4 flex items-center justify-between text-xs font-semibold">
                    <div class="flex items-center gap-1.5 text-gray-500">
                      <span>Status:</span>
                      <% if (order.orderStatus === 'Cancelled') { %>
                        <span class="text-rose-600 font-bold"><%= order.orderStatus.toUpperCase() %></span>
                      <% } else if (order.orderStatus === 'Returned') { %>
                        <span class="text-purple-600 font-bold"><%= order.orderStatus.toUpperCase() %></span>
                      <% } else if (order.orderStatus === 'Delivered') { %>
                        <span class="text-emerald-600 font-bold"><%= order.orderStatus.toUpperCase() %></span>
                      <% } else { %>
                        <span class="text-amber-600 font-bold"><%= order.orderStatus.toUpperCase() %></span>
                      <% } %>
                    </div>

                    <div class="flex items-center gap-4">
                      <% if (order.paymentStatus === 'Failed') { %>
                        <a 
                          href="/payment-failure/<%= order._id %>" 
                          class="bg-amber-600 hover:bg-amber-700 text-white transition-colors text-[10px] tracking-widest font-bold uppercase px-3 py-2 rounded-sm flex items-center gap-1"
                        >
                          <i class="fa-solid fa-rotate-right"></i> Retry Payment
                        </a>
                      <% } %>

                      <!-- Invoice Download Button -->
                      <a 
                        href="/profile/orders/<%= order._id %>/invoice" 
                        class="text-gray-600 hover:text-black transition-colors flex items-center gap-1 font-bold text-[10px] tracking-wider uppercase"
                        title="Download PDF Invoice"
                      >
                        <i class="fa-solid fa-file-pdf text-xs"></i> Invoice
                      </a>

                      <!-- View Details Link -->
                      <a 
                        href="/profile/orders/<%= order._id %>" 
                        class="bg-black text-white hover:bg-gray-800 transition-colors text-[10px] tracking-widest font-bold uppercase px-4 py-2 rounded-sm"
                      >
                        Manage Order
                      </a>
                    </div>
                  </div>

                </div>
              <% }); %>
            </div>

            <!-- Pagination -->
            <% if (totalPages > 1) { %>
              <div class="flex justify-center items-center gap-3 mt-10 text-xs">
                <% if (currentPage > 1) { %>
                  <a href="/profile/orders?page=<%= currentPage - 1 %>&search=<%= search %>" class="w-8 h-8 flex items-center justify-center border border-gray-200 rounded-sm hover:border-black transition-colors text-gray-600">
                    <i class="fa-solid fa-chevron-left text-[10px]"></i>
                  </a>
                <% } %>

                <span class="text-gray-400 font-semibold">Page <%= currentPage %> of <%= totalPages %></span>

                <% if (currentPage < totalPages) { %>
                  <a href="/profile/orders?page=<%= currentPage + 1 %>&search=<%= search %>" class="w-8 h-8 flex items-center justify-center border border-gray-200 rounded-sm hover:border-black transition-colors text-gray-600">
                    <i class="fa-solid fa-chevron-right text-[10px]"></i>
                  </a>
                <% } %>
              </div>
            <% } %>

          <% } else { %>
            <!-- Empty Listing State -->
            <div class="text-center py-16 bg-gray-50 rounded-xl border border-dashed border-gray-200 mt-4">
              <div class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <i class="fa-solid fa-clock-rotate-left text-xl text-gray-400"></i>
              </div>
              <h3 class="text-sm font-bold text-gray-800 tracking-wider uppercase mb-1">No Orders Found</h3>
              <p class="text-xs text-gray-400 max-w-xs mx-auto leading-relaxed mb-6">
                <%= search ? "We couldn't find any orders matching your search keywords." : "You haven't placed any luxury orders with ZIYAURA yet." %>
              </p>
              <a href="/products" class="inline-block bg-black hover:bg-gray-800 text-white text-[10px] font-bold tracking-widest uppercase px-6 py-2.5 rounded-sm transition-colors">
                Shop Curated Catalog
              </a>
            </div>
          <% } %>

        </div>
      </div>
      
    </div>
  </div>
</div>

<%- include("../partials/user/footer") %>
<%- include("../partials/toast") %>
