<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>Signup</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>

<body class="bg-gray-100">

  <div class="flex h-screen">

    <div class="w-1/2 bg-gray-100 flex flex-col justify-center px-20 relative">
      <h1 class="absolute top-8 left-20 text-xl font-semibold tracking-widest text-white">
        ZIYAURA
      </h1>

      <div class="mt-16">
        <p class="text-2xl text-gray-800 mb-6">
          Explore the things you love.
        </p>
        <img src="/images/signupimage.webp" class="rounded-lg shadow-md w-full max-w-md">
      </div>
    </div>

    <div class="w-1/2 flex justify-center items-start py-10 overflow-y-auto">
      <div class="bg-white p-8 rounded-lg shadow-md w-full max-w-md my-auto">

        <h2 class="text-xl font-semibold mb-4 text-center">
          Create Account
        </h2>

        <form id="signupForm" action="/signup" method="POST" class="space-y-4">

          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1">Username</label>
            <input id="name" name="name" placeholder="Enter username"
              class="w-full p-3 border rounded focus:outline-none focus:ring-2 focus:ring-blue-600 transition-colors">
            <span id="nameError" class="text-red-500 text-xs hidden mt-1 block"></span>
          </div>

          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1">Email Address</label>
            <input id="email" type="email" name="email" placeholder="Enter email address"
              class="w-full p-3 border rounded focus:outline-none focus:ring-2 focus:ring-blue-600 transition-colors">
            <span id="emailError" class="text-red-500 text-xs hidden mt-1 block"></span>
          </div>

          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1">Password</label>
            <div class="relative">
              <input type="password" id="password" name="password" placeholder="Enter password" 
                class="w-full p-3 border rounded focus:outline-none focus:ring-2 focus:ring-blue-600 pr-12 transition-colors">

              <button type="button" onclick="togglePassword('password', 'passwordIcon')"
                class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-500">
                <i id="passwordIcon" class="fa-solid fa-eye"></i>
              </button>
            </div>
            <span id="passwordError" class="text-red-500 text-xs hidden mt-1 block"></span>

            <div id="passwordRules" class="text-xs space-y-1 mt-2">
              <p id="lengthRule" class="text-gray-500">✗ Minimum 8 characters</p>
              <p id="uppercaseRule" class="text-gray-500">✗ One uppercase letter</p>
              <p id="lowercaseRule" class="text-gray-500">✗ One lowercase letter</p>
              <p id="numberRule" class="text-gray-500">✗ One number</p>
              <p id="specialRule" class="text-gray-500">✗ One special character</p>
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1">Confirm Password</label>
            <div class="relative">
              <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm password" 
                class="w-full p-3 border rounded focus:outline-none focus:ring-2 focus:ring-blue-600 pr-12 transition-colors">

              <button type="button" onclick="togglePassword('confirmPassword', 'confirmPasswordIcon')"
                class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-500">
                <i id="confirmPasswordIcon" class="fa-solid fa-eye"></i>
              </button>
            </div>
            <span id="confirmPasswordError" class="text-red-500 text-xs hidden mt-1 block"></span>
          </div>

          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1">Phone Number (Optional)</label>
            <input id="phone" name="phone" placeholder="10-digit phone number"
              class="w-full p-3 border rounded focus:outline-none focus:ring-2 focus:ring-blue-600 transition-colors">
            <span id="phoneError" class="text-red-500 text-xs hidden mt-1 block"></span>
          </div>

          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1">Referral Code (Optional)</label>
            <input id="referralCode" name="referralCode" value="<%= typeof referralCode !== 'undefined' ? referralCode : '' %>" placeholder="e.g. REF-ABC123"
              class="w-full p-3 border rounded focus:outline-none focus:ring-2 focus:ring-blue-600 transition-colors">
            <span id="referralCodeError" class="text-red-500 text-xs hidden mt-1 block"></span>
          </div>

          <button type="submit" class="w-full bg-blue-700 hover:bg-blue-800 text-white py-3 rounded font-medium transition-colors">
            Sign Up
          </button>
        </form>

        <div class="flex items-center my-5">
          <div class="flex-grow h-px bg-gray-300"></div>
          <span class="px-3 text-sm text-gray-500">or continue with</span>
          <div class="flex-grow h-px bg-gray-300"></div>
        </div>

        <div class="space-y-3">
          <a href="/auth/google"
            class="w-full flex items-center justify-center gap-3 border border-gray-300 py-3 rounded hover:bg-gray-100">
            <img src="/images/googlelogo.jpg" class="w-7 h-7">
            <span class="text-sm font-medium text-gray-700">Continue with Google</span>
          </a>
        </div>

        <p class="text-center mt-4 text-sm">
          Already have an account?
          <a href="/login" class="text-blue-600 font-semibold">Login</a>
        </p>

      </div>
    </div>
  </div>

  <script>
    function togglePassword(inputId, iconId) {
      const input = document.getElementById(inputId);
      const icon = document.getElementById(iconId);
      if (input.type === "password") {
        input.type = "text";
        icon.classList.remove("fa-eye");
        icon.classList.add("fa-eye-slash");
      } else {
        input.type = "password";
        icon.classList.remove("fa-eye-slash");
        icon.classList.add("fa-eye");
      }
    }

    const passwordInput = document.getElementById("password");
    const lengthRule = document.getElementById("lengthRule");
    const uppercaseRule = document.getElementById("uppercaseRule");
    const lowercaseRule = document.getElementById("lowercaseRule");
    const numberRule = document.getElementById("numberRule");
    const specialRule = document.getElementById("specialRule");

    passwordInput.addEventListener("keyup", () => {
      const password = passwordInput.value;
      
      if (password.length >= 8) {
        lengthRule.innerHTML = "✓ Minimum 8 characters";
        lengthRule.className = "text-green-600";
      } else {
        lengthRule.innerHTML = "✗ Minimum 8 characters";
        lengthRule.className = "text-gray-500";
      }

      if (/[A-Z]/.test(password)) {
        uppercaseRule.innerHTML = "✓ One uppercase letter";
        uppercaseRule.className = "text-green-600";
      } else {
        uppercaseRule.innerHTML = "✗ One uppercase letter";
        uppercaseRule.className = "text-gray-500";
      }

      if (/[a-z]/.test(password)) {
        lowercaseRule.innerHTML = "✓ One lowercase letter";
        lowercaseRule.className = "text-green-600";
      } else {
        lowercaseRule.innerHTML = "✗ One lowercase letter";
        lowercaseRule.className = "text-gray-500";
      }

      if (/[0-9]/.test(password)) {
        numberRule.innerHTML = "✓ One number";
        numberRule.className = "text-green-600";
      } else {
        numberRule.innerHTML = "✗ One number";
        numberRule.className = "text-gray-500";
      }

      if (/[^A-Za-z0-9]/.test(password)) {
        specialRule.innerHTML = "✓ One special character";
        specialRule.className = "text-green-600";
      } else {
        specialRule.innerHTML = "✗ One special character";
        specialRule.className = "text-gray-500";
      }
    });

    const signupForm = document.getElementById("signupForm");
    const nameInput = document.getElementById("name");
    const emailInput = document.getElementById("email");
    const confirmPasswordInput = document.getElementById("confirmPassword");
    const phoneInput = document.getElementById("phone");
    const referralInput = document.getElementById("referralCode");

    function showError(inputId, errorId, message) {
      const input = document.getElementById(inputId);
      const errorEl = document.getElementById(errorId);
      if (errorEl) {
        errorEl.innerText = message;
        errorEl.classList.remove("hidden");
      }
      if (input) {
        input.classList.add("border-red-500");
      }
    }

    function clearError(inputId, errorId) {
      const input = document.getElementById(inputId);
      const errorEl = document.getElementById(errorId);
      if (errorEl) {
        errorEl.innerText = "";
        errorEl.classList.add("hidden");
      }
      if (input) {
        input.classList.remove("border-red-500");
      }
    }

    function clearAllErrors() {
      [
        { input: "name", error: "nameError" },
        { input: "email", error: "emailError" },
        { input: "password", error: "passwordError" },
        { input: "confirmPassword", error: "confirmPasswordError" },
        { input: "phone", error: "phoneError" },
        { input: "referralCode", error: "referralCodeError" }
      ].forEach(item => clearError(item.input, item.error));
    }

    // Real-time Field-wise Blur & Input Listeners
    nameInput.addEventListener("input", () => {
      const val = nameInput.value.trim();
      if (val && (val.length < 3 || val.length > 50 || !/^[A-Za-z\s]+$/.test(val))) {
        showError("name", "nameError", "Username must be 3-50 letters and spaces only");
      } else {
        clearError("name", "nameError");
      }
    });

    emailInput.addEventListener("input", () => {
      const val = emailInput.value.trim();
      const pattern = /^[^ ]+@[^ ]+\.[a-z]{2,3}$/i;
      if (val && !pattern.test(val)) {
        showError("email", "emailError", "Enter a valid email address");
      } else {
        clearError("email", "emailError");
      }
    });

    confirmPasswordInput.addEventListener("input", () => {
      if (confirmPasswordInput.value && confirmPasswordInput.value !== passwordInput.value) {
        showError("confirmPassword", "confirmPasswordError", "Passwords do not match");
      } else {
        clearError("confirmPassword", "confirmPasswordError");
      }
    });

    phoneInput.addEventListener("input", () => {
      const val = phoneInput.value.trim();
      if (val && !/^[0-9]{10}$/.test(val)) {
        showError("phone", "phoneError", "Phone number must be exactly 10 digits");
      } else {
        clearError("phone", "phoneError");
      }
    });

    // Form Submit Event Listener
    signupForm.addEventListener("submit", (e) => {
      clearAllErrors();
      let isValid = true;

      const nameVal = nameInput.value.trim();
      if (!nameVal) {
        showError("name", "nameError", "Username is required");
        isValid = false;
      } else if (nameVal.length < 3 || nameVal.length > 50 || !/^[A-Za-z\s]+$/.test(nameVal)) {
        showError("name", "nameError", "Username must be 3-50 letters and spaces only");
        isValid = false;
      }

      const emailVal = emailInput.value.trim();
      const emailPattern = /^[^ ]+@[^ ]+\.[a-z]{2,3}$/i;
      if (!emailVal) {
        showError("email", "emailError", "Email address is required");
        isValid = false;
      } else if (!emailPattern.test(emailVal)) {
        showError("email", "emailError", "Enter a valid email address");
        isValid = false;
      }

      const passVal = passwordInput.value;
      if (!passVal) {
        showError("password", "passwordError", "Password is required");
        isValid = false;
      } else if (passVal.length < 8 || !/[A-Z]/.test(passVal) || !/[a-z]/.test(passVal) || !/[0-9]/.test(passVal) || !/[^A-Za-z0-9]/.test(passVal)) {
        showError("password", "passwordError", "Password must meet all complexity requirements");
        isValid = false;
      }

      if (!confirmPasswordInput.value) {
        showError("confirmPassword", "confirmPasswordError", "Please confirm password");
        isValid = false;
      } else if (passVal !== confirmPasswordInput.value) {
        showError("confirmPassword", "confirmPasswordError", "Passwords do not match");
        isValid = false;
      }

      const phoneVal = phoneInput.value.trim();
      if (phoneVal && !/^[0-9]{10}$/.test(phoneVal)) {
        showError("phone", "phoneError", "Phone number must be exactly 10 digits");
        isValid = false;
      }

      if (!isValid) {
        e.preventDefault();
      }
    });
  </script>

  <%- include("../partials/toast") %>
</body>

</html>