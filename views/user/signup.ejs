<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Account | ZIYAURA</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
    body {
      font-family: 'Inter', sans-serif;
    }
  </style>
</head>

<body class="bg-gray-50 min-h-screen text-gray-900 antialiased py-8 sm:py-12 px-4 sm:px-6">

  <div class="max-w-md w-full mx-auto">

    <!-- Luxury Card -->
    <div class="bg-white p-6 sm:p-10 rounded-2xl shadow-sm sm:shadow-md border border-gray-100">

      <!-- Header & Brand Logo -->
      <div class="text-center mb-8">
        <a href="/" class="inline-block focus:outline-none">
          <h1 class="text-2xl sm:text-3xl font-bold tracking-[0.25em] text-gray-900">ZIYAURA</h1>
        </a>
        <p class="text-[11px] uppercase tracking-widest text-gray-400 mt-1.5 font-light">Luxury Fragrances</p>
        
        <h2 class="text-xl sm:text-2xl font-bold text-gray-900 tracking-tight mt-6">
          Create Account
        </h2>
        <p class="text-xs text-gray-500 mt-1">
          Join Ziyaura to explore bespoke perfumes & offers
        </p>
      </div>

      <form id="signupForm" action="/signup" method="POST" class="space-y-4">

        <!-- Username -->
        <div>
          <label for="name" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1.5">Username</label>
          <input id="name" name="name" type="text" placeholder="Enter username"
            class="w-full px-4 py-3 text-sm bg-gray-50/50 border border-gray-200 rounded-lg focus:outline-none focus:border-black focus:ring-1 focus:ring-black transition-colors">
          <span id="nameError" class="text-rose-500 text-xs hidden mt-1 block font-medium"></span>
        </div>

        <!-- Email Address -->
        <div>
          <label for="email" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1.5">Email Address</label>
          <input id="email" type="email" name="email" placeholder="name@example.com"
            class="w-full px-4 py-3 text-sm bg-gray-50/50 border border-gray-200 rounded-lg focus:outline-none focus:border-black focus:ring-1 focus:ring-black transition-colors">
          <span id="emailError" class="text-rose-500 text-xs hidden mt-1 block font-medium"></span>
        </div>

        <!-- Password -->
        <div>
          <label for="password" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1.5">Password</label>
          <div class="relative">
            <input type="password" id="password" name="password" placeholder="Create password" 
              class="w-full px-4 py-3 text-sm bg-gray-50/50 border border-gray-200 rounded-lg focus:outline-none focus:border-black focus:ring-1 focus:ring-black pr-11 transition-colors">

            <button type="button" onclick="togglePassword('password', 'passwordIcon')" aria-label="Toggle password visibility"
              class="absolute right-3.5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-700 transition-colors p-1">
              <i id="passwordIcon" class="fa-solid fa-eye text-sm"></i>
            </button>
          </div>
          <span id="passwordError" class="text-rose-500 text-xs hidden mt-1 block font-medium"></span>

          <!-- Password Requirements Checklist -->
          <div id="passwordRules" class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 mt-2.5 p-3 bg-gray-50 rounded-lg border border-gray-100 text-[11px]">
            <p id="lengthRule" class="text-gray-400 flex items-center gap-1.5 transition-colors">
              <i class="fa-solid fa-circle-xmark text-[10px]"></i> <span>Min. 8 characters</span>
            </p>
            <p id="uppercaseRule" class="text-gray-400 flex items-center gap-1.5 transition-colors">
              <i class="fa-solid fa-circle-xmark text-[10px]"></i> <span>One uppercase</span>
            </p>
            <p id="lowercaseRule" class="text-gray-400 flex items-center gap-1.5 transition-colors">
              <i class="fa-solid fa-circle-xmark text-[10px]"></i> <span>One lowercase</span>
            </p>
            <p id="numberRule" class="text-gray-400 flex items-center gap-1.5 transition-colors">
              <i class="fa-solid fa-circle-xmark text-[10px]"></i> <span>One number</span>
            </p>
            <p id="specialRule" class="text-gray-400 flex items-center gap-1.5 sm:col-span-2 transition-colors">
              <i class="fa-solid fa-circle-xmark text-[10px]"></i> <span>One special character</span>
            </p>
          </div>
        </div>

        <!-- Confirm Password -->
        <div>
          <label for="confirmPassword" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1.5">Confirm Password</label>
          <div class="relative">
            <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Re-enter password" 
              class="w-full px-4 py-3 text-sm bg-gray-50/50 border border-gray-200 rounded-lg focus:outline-none focus:border-black focus:ring-1 focus:ring-black pr-11 transition-colors">

            <button type="button" onclick="togglePassword('confirmPassword', 'confirmPasswordIcon')" aria-label="Toggle password visibility"
              class="absolute right-3.5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-700 transition-colors p-1">
              <i id="confirmPasswordIcon" class="fa-solid fa-eye text-sm"></i>
            </button>
          </div>
          <span id="confirmPasswordError" class="text-rose-500 text-xs hidden mt-1 block font-medium"></span>
        </div>

        <!-- Phone Number -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="phone" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider">Phone Number</label>
            <span class="text-[11px] text-gray-400 font-normal">Optional</span>
          </div>
          <input id="phone" name="phone" type="tel" placeholder="10-digit mobile number"
            class="w-full px-4 py-3 text-sm bg-gray-50/50 border border-gray-200 rounded-lg focus:outline-none focus:border-black focus:ring-1 focus:ring-black transition-colors">
          <span id="phoneError" class="text-rose-500 text-xs hidden mt-1 block font-medium"></span>
        </div>

        <!-- Referral Code -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="referralCode" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider">Referral Code</label>
            <span class="text-[11px] text-gray-400 font-normal">Optional</span>
          </div>
          <input id="referralCode" name="referralCode" value="<%= typeof referralCode !== 'undefined' ? referralCode : '' %>" placeholder="e.g. REF-ABC123"
            class="w-full px-4 py-3 text-sm bg-gray-50/50 border border-gray-200 rounded-lg focus:outline-none focus:border-black focus:ring-1 focus:ring-black transition-colors">
          <span id="referralCodeError" class="text-rose-500 text-xs hidden mt-1 block font-medium"></span>
        </div>

        <!-- Submit Button -->
        <button type="submit" id="signupSubmitButton"
          class="w-full bg-black hover:bg-gray-800 text-white py-3.5 rounded-lg text-xs font-semibold uppercase tracking-widest transition-all duration-200 shadow-sm active:scale-[0.99] cursor-pointer mt-2">
          Create Account
        </button>
      </form>

      <!-- Divider -->
      <div class="flex items-center my-6">
        <div class="flex-grow h-px bg-gray-200"></div>
        <span class="px-3 text-xs uppercase tracking-wider text-gray-400 font-medium">
          or continue with
        </span>
        <div class="flex-grow h-px bg-gray-200"></div>
      </div>

      <!-- Google OAuth -->
      <div class="space-y-3">
        <a href="/auth/google"
          class="w-full flex items-center justify-center gap-3 border border-gray-200 py-3 rounded-lg hover:border-gray-400 hover:bg-gray-50 transition-all duration-200 group">
          <svg class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.66-5.17 3.66-9.17z"/>
            <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.34 24 12 24z"/>
            <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 10.02 0 12s.45 3.82 1.25 5.42l4.03-3.15z"/>
            <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.34 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
          </svg>
          <span class="text-xs font-semibold uppercase tracking-wider text-gray-700 group-hover:text-black transition-colors">
            Continue with Google
          </span>
        </a>
      </div>

      <!-- Login Link -->
      <p class="text-center mt-6 text-xs text-gray-600">
        Already have an account?
        <a href="/login" class="text-black font-semibold hover:underline ml-1">
          Login
        </a>
      </p>

    </div>

  </div>

  <script>
    function togglePassword(inputId, iconId) {
      const input = document.getElementById(inputId);
      const icon = document.getElementById(iconId);
      if (input.type === "password") {
        input.type = "text";
        icon.classList.remove("fa-eye");
        icon.classList.add("fa-eye-slash");
      } else {
        input.type = "password";
        icon.classList.remove("fa-eye-slash");
        icon.classList.add("fa-eye");
      }
    }

    const passwordInput = document.getElementById("password");
    const lengthRule = document.getElementById("lengthRule");
    const uppercaseRule = document.getElementById("uppercaseRule");
    const lowercaseRule = document.getElementById("lowercaseRule");
    const numberRule = document.getElementById("numberRule");
    const specialRule = document.getElementById("specialRule");

    function setRuleStatus(el, isValid, text) {
      if (isValid) {
        el.className = "text-emerald-600 flex items-center gap-1.5 transition-colors font-medium";
        el.innerHTML = `<i class="fa-solid fa-circle-check text-[10px] text-emerald-500"></i> <span>${text}</span>`;
      } else {
        el.className = "text-gray-400 flex items-center gap-1.5 transition-colors";
        el.innerHTML = `<i class="fa-solid fa-circle-xmark text-[10px]"></i> <span>${text}</span>`;
      }
    }

    passwordInput.addEventListener("keyup", () => {
      const password = passwordInput.value;
      setRuleStatus(lengthRule, password.length >= 8, "Min. 8 characters");
      setRuleStatus(uppercaseRule, /[A-Z]/.test(password), "One uppercase");
      setRuleStatus(lowercaseRule, /[a-z]/.test(password), "One lowercase");
      setRuleStatus(numberRule, /[0-9]/.test(password), "One number");
      setRuleStatus(specialRule, /[^A-Za-z0-9]/.test(password), "One special character");
    });

    const signupForm = document.getElementById("signupForm");
    const nameInput = document.getElementById("name");
    const emailInput = document.getElementById("email");
    const confirmPasswordInput = document.getElementById("confirmPassword");
    const phoneInput = document.getElementById("phone");
    const referralInput = document.getElementById("referralCode");

    function showError(inputId, errorId, message) {
      const input = document.getElementById(inputId);
      const errorEl = document.getElementById(errorId);
      if (errorEl) {
        errorEl.innerText = message;
        errorEl.classList.remove("hidden");
      }
      if (input) {
        input.classList.remove("border-gray-200");
        input.classList.add("border-rose-500", "focus:border-rose-500", "focus:ring-rose-500");
      }
    }

    function clearError(inputId, errorId) {
      const input = document.getElementById(inputId);
      const errorEl = document.getElementById(errorId);
      if (errorEl) {
        errorEl.innerText = "";
        errorEl.classList.add("hidden");
      }
      if (input) {
        input.classList.remove("border-rose-500", "focus:border-rose-500", "focus:ring-rose-500");
        input.classList.add("border-gray-200");
      }
    }

    function clearAllErrors() {
      [
        { input: "name", error: "nameError" },
        { input: "email", error: "emailError" },
        { input: "password", error: "passwordError" },
        { input: "confirmPassword", error: "confirmPasswordError" },
        { input: "phone", error: "phoneError" },
        { input: "referralCode", error: "referralCodeError" }
      ].forEach(item => clearError(item.input, item.error));
    }

    // Real-time Field-wise Blur & Input Listeners
    nameInput.addEventListener("input", () => {
      const val = nameInput.value.trim();
      if (val && (val.length < 3 || val.length > 50 || !/^[A-Za-z\s]+$/.test(val))) {
        showError("name", "nameError", "Username must be 3-50 letters and spaces only");
      } else {
        clearError("name", "nameError");
      }
    });

    emailInput.addEventListener("input", () => {
      const val = emailInput.value.trim();
      const pattern = /^[^ ]+@[^ ]+\.[a-z]{2,3}$/i;
      if (val && !pattern.test(val)) {
        showError("email", "emailError", "Enter a valid email address");
      } else {
        clearError("email", "emailError");
      }
    });

    confirmPasswordInput.addEventListener("input", () => {
      if (confirmPasswordInput.value && confirmPasswordInput.value !== passwordInput.value) {
        showError("confirmPassword", "confirmPasswordError", "Passwords do not match");
      } else {
        clearError("confirmPassword", "confirmPasswordError");
      }
    });

    phoneInput.addEventListener("input", () => {
      const val = phoneInput.value.trim();
      if (val && !/^[0-9]{10}$/.test(val)) {
        showError("phone", "phoneError", "Phone number must be exactly 10 digits");
      } else {
        clearError("phone", "phoneError");
      }
    });

    // Form Submit Event Listener
    signupForm.addEventListener("submit", (e) => {
      clearAllErrors();
      let isValid = true;

      const nameVal = nameInput.value.trim();
      if (!nameVal) {
        showError("name", "nameError", "Username is required");
        isValid = false;
      } else if (nameVal.length < 3 || nameVal.length > 50 || !/^[A-Za-z\s]+$/.test(nameVal)) {
        showError("name", "nameError", "Username must be 3-50 letters and spaces only");
        isValid = false;
      }

      const emailVal = emailInput.value.trim();
      const emailPattern = /^[^ ]+@[^ ]+\.[a-z]{2,3}$/i;
      if (!emailVal) {
        showError("email", "emailError", "Email address is required");
        isValid = false;
      } else if (!emailPattern.test(emailVal)) {
        showError("email", "emailError", "Enter a valid email address");
        isValid = false;
      }

      const passVal = passwordInput.value;
      if (!passVal) {
        showError("password", "passwordError", "Password is required");
        isValid = false;
      } else if (passVal.length < 8 || !/[A-Z]/.test(passVal) || !/[a-z]/.test(passVal) || !/[0-9]/.test(passVal) || !/[^A-Za-z0-9]/.test(passVal)) {
        showError("password", "passwordError", "Password must meet all complexity requirements");
        isValid = false;
      }

      if (!confirmPasswordInput.value) {
        showError("confirmPassword", "confirmPasswordError", "Please confirm password");
        isValid = false;
      } else if (passVal !== confirmPasswordInput.value) {
        showError("confirmPassword", "confirmPasswordError", "Passwords do not match");
        isValid = false;
      }

      const phoneVal = phoneInput.value.trim();
      if (phoneVal && !/^[0-9]{10}$/.test(phoneVal)) {
        showError("phone", "phoneError", "Phone number must be exactly 10 digits");
        isValid = false;
      }

      if (!isValid) {
        e.preventDefault();
      }
    });
  </script>

  <%- include("../partials/toast") %>
</body>

</html>