<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Verify OTP</title>

  <script src="https://cdn.tailwindcss.com"></script>

</head>

<body class="bg-gray-100 min-h-screen">

  <div class="min-h-screen flex flex-col md:flex-row">

    <!-- LEFT SIDE -->

    <div class="hidden md:flex md:w-1/2 bg-gray-900 flex-col justify-center px-12 lg:px-20 relative text-white">

      <h1 class="absolute top-8 left-12 lg:left-20 text-xl font-semibold tracking-widest text-white">

        ZIYAURA

      </h1>

      <div class="mt-16">

        <p class="text-2xl text-gray-200 mb-6 font-light">

          Secure verification for your account.

        </p>

        <img
          src="/images/signupimage.webp"
          class="rounded-lg shadow-md w-full max-w-md object-cover"
        >

      </div>

    </div>


    <!-- RIGHT SIDE -->

    <div class="w-full md:w-1/2 flex justify-center items-center py-10 px-4 sm:px-6">

      <div class="bg-white p-6 sm:p-8 rounded-lg shadow-md w-full max-w-md my-auto">

        <h2 class="text-2xl font-semibold mb-2 text-center">

          Verify OTP

        </h2>

        <p class="text-sm text-gray-500 text-center mb-6">

          We have sent a 6-digit OTP to your email

        </p>


        <!-- FLASH MESSAGES -->




        <!-- VERIFY OTP FORM -->

        <form
          id="otpForm"
          action="/verify-otp-reset"
          method="POST"
          class="space-y-5"
        >

          <input
            type="hidden"
            name="email"
            value="<%= email %>"
          >


          <input
            id="otpInput"
            type="text"
            name="otp"
            maxlength="6"
            placeholder="------"
            required
            class="w-full border rounded-xl p-4 text-center tracking-[10px] text-xl focus:outline-none focus:ring-2 focus:ring-blue-600"
          >


          <p
            id="otpError"
            class="text-red-500 text-sm text-center"
          ></p>


          <button
            id="verifyButton"
            type="submit"
            class="w-full bg-blue-700 hover:bg-blue-800 text-white py-3 rounded-xl font-semibold"
          >

            Verify OTP

          </button>

        </form>


        <!-- TIMER -->

        <div class="mt-6 text-center">

          <p
            id="timer"
            class="text-sm text-gray-500"
          >

            OTP expires in 05:00

          </p>

        </div>


        <!-- RESEND OTP -->

        <form
          id="resendForm"
          action="/forgot-password"
          method="POST"
          class="hidden mt-4 text-center"
        >

          <input
            type="hidden"
            name="email"
            value="<%= email %>"
          >

          <button
            id="resendButton"
            type="submit"
            class="text-blue-600 font-semibold hover:text-blue-800"
          >

            Resend OTP

          </button>

        </form>

      </div>

    </div>

  </div>


  <script>

    const otpForm =
      document.getElementById("otpForm");

    const otpInput =
      document.getElementById("otpInput");

    const otpError =
      document.getElementById("otpError");

    const verifyButton =
      document.getElementById("verifyButton");

    const timer =
      document.getElementById("timer");

    const resendForm =
      document.getElementById("resendForm");

    const resendButton =
      document.getElementById("resendButton");


    // OTP VALIDATION

    otpForm.addEventListener("submit", (e) => {

      otpError.innerText = "";


      if (!/^[0-9]{6}$/.test(otpInput.value)) {

        e.preventDefault();

        otpError.innerText =
          "Enter valid 6-digit OTP";

        return;

      }


      verifyButton.innerText =
        "Verifying...";

      verifyButton.disabled = true;

    });


  // TIMER

  let timeLeft = parseInt("<%= timeLeft %>") || 0;

  const updateTimerDisplay = (secondsRemaining) => {
    if (secondsRemaining <= 0) {
      clearInterval(countdown);
      timer.innerText = "OTP expired";
      timer.classList.remove("text-gray-500");
      timer.classList.add("text-red-500");
      resendForm.classList.remove("hidden");
      return;
    }

    const minutes = Math.floor(secondsRemaining / 60);
    const seconds = secondsRemaining % 60;

    timer.innerText =
      `OTP expires in ${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")}`;
  };

  updateTimerDisplay(timeLeft);

  const countdown = setInterval(() => {
    timeLeft--;
    updateTimerDisplay(timeLeft);
  }, 1000);

  // RESEND BUTTON

  resendForm.addEventListener("submit", () => {
    resendButton.innerText = "Sending...";
    resendButton.disabled = true;
  });

  </script>

  <%- include("../partials/toast") %>
</body>

</html>