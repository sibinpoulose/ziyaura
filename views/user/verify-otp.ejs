<!DOCTYPE html>
<html>

<head>
  <title>Verify OTP</title>
  <style>
    body {
      font-family: Arial;
      background: #f2f2f2;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
    }

    .box {
      background: #ddd;
      padding: 40px;
      border-radius: 10px;
      text-align: center;
      width: 400px;
    }

    input {
      width: 100%;
      padding: 12px;
      margin-top: 20px;
      border-radius: 10px;
      border: 1px solid #ccc;
    }

    button {
      margin-top: 20px;
      padding: 12px;
      width: 100%;
      border: none;
      border-radius: 10px;
      background: #5a67d8;
      color: white;
      font-size: 16px;
      cursor: pointer;
    }

    p {
      color: red;
    }
  </style>
</head>

<body>
  <div class="box">
    <h2>Enter OTP</h2>
    <p>We sent an OTP to your email</p>

    <form action="/verify-otp-reset" method="POST">
      <input type="hidden" name="email" value="<%= email %>" />
      <input type="text" name="otp" placeholder="Enter OTP" required />
      <button type="submit">Verify</button>
    </form>

    <% if (success) { %>

      <div style="
    background:#d1fae5;
    color:#065f46;
    padding:12px;
    border-radius:8px;
    margin-top:15px;
  ">

        <%= success %>

      </div>

      <% } %>


        <% if (error) { %>

          <div style="
    background:#fee2e2;
    color:#991b1b;
    padding:12px;
    border-radius:8px;
    margin-top:15px;
  ">

            <%= error %>

          </div>

          <% } %>
  </div>
</body>

</html>