<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Forgot Password</title>

    <script src="https://cdn.tailwindcss.com"></script>

</head>

<body class="bg-gray-100 min-h-screen">

    <div class="min-h-screen flex flex-col md:flex-row">

        <div class="hidden md:flex md:w-1/2 bg-gray-900 flex-col justify-center px-12 lg:px-20 relative text-white">

            <h1 class="absolute top-8 left-12 lg:left-20 text-xl font-semibold tracking-widest text-white">

                ZIYAURA

            </h1>

            <div class="mt-16">

                <p class="text-2xl text-gray-200 mb-6 font-light">

                    Recover your account securely.

                </p>

                <img src="/images/signupimage.webp" class="rounded-lg shadow-md w-full max-w-md object-cover">

            </div>

        </div>

        <div class="w-full md:w-1/2 flex justify-center items-center py-10 px-4 sm:px-6">

            <div class="bg-white p-6 sm:p-8 rounded-lg shadow-md w-full max-w-md my-auto">

                <h2 class="text-xl font-semibold mb-2 text-center">

                    Forgot Password

                </h2>

                <p class="text-sm text-gray-500 text-center mb-6">

                    Enter your email to receive OTP

                </p>

                <form id="forgotForm" action="/forgot-password" method="POST" class="space-y-4">

                    <input id="email" type="email" name="email" placeholder="Enter your email" required
                        class="w-full p-3 border rounded focus:outline-none focus:ring-2 focus:ring-blue-600">

                    <p id="forgotError" class="text-red-500 text-sm text-center"></p>

                                    <button id="forgotButton" type="submit"
                                        class="w-full bg-blue-700 hover:bg-blue-800 text-white py-3 rounded">

                                        Send OTP

                                    </button>

                </form>

                <p class="text-center mt-4 text-sm">

                    Remember your password?

                    <a href="/login" class="text-blue-600">

                        Login

                    </a>

                </p>

            </div>

        </div>

    </div>

    <script>

        const forgotForm =
            document.getElementById("forgotForm");

        const emailInput =
            document.getElementById("email");

        const forgotError =
            document.getElementById("forgotError");

        const forgotButton =
            document.getElementById("forgotButton");


        forgotForm.addEventListener("submit", (e) => {

            forgotError.innerText = "";


            if (!emailInput.value.trim()) {

                e.preventDefault();

                forgotError.innerText =
                    "Email is required";

                return;

            }


            const emailPattern =
                /^[^ ]+@[^ ]+\.[a-z]{2,3}$/i;

            if (!emailInput.value.match(emailPattern)) {

                e.preventDefault();

                forgotError.innerText =
                    "Enter valid email";

                return;

            }


            forgotButton.innerText =
                "Sending OTP...";

            forgotButton.disabled = true;

        });

    </script>

  <%- include("../partials/toast") %>
</body>

</html>