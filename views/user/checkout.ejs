<%- include("../partials/user/header") %>

<!-- Main Wrapper -->
<div class="bg-white min-h-screen py-8">
  <main class="max-w-[1440px] mx-auto px-4 md:px-8 w-full">
    
    <!-- Breadcrumbs -->
    <nav class="text-[10px] font-bold tracking-widest text-gray-400 uppercase mb-8">
      <a href="/home" class="hover:text-black">Home</a>
      <span class="mx-2">/</span>
      <a href="/cart" class="hover:text-black">Shopping Bag</a>
      <span class="mx-2">/</span>
      <span class="text-black">Checkout</span>
    </nav>

    <h1 class="text-xl md:text-2xl font-bold tracking-tight text-gray-900 mb-8 uppercase">
      CHECKOUT
    </h1>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-start">
      
      <!-- Left side: Shipping Details & Payment Method (2/3 width) -->
      <div class="lg:col-span-2 space-y-8">
        
        <!-- Address Section -->
        <div class="border border-gray-100 rounded-sm p-6 bg-white space-y-6">
          <div class="flex justify-between items-center border-b border-gray-100 pb-4">
            <h2 class="text-xs font-bold tracking-widest text-gray-800 uppercase flex items-center gap-2">
              <i class="fa-regular fa-address-card text-sm"></i>
              SHIPPING ADDRESS
            </h2>
            <button 
              type="button" 
              onclick="openAddressModal()"
              class="text-[10px] font-bold tracking-widest text-gray-500 hover:text-black uppercase flex items-center gap-1.5 transition-colors"
            >
              <i class="fa-solid fa-plus text-[9px]"></i>
              Add New Address
            </button>
          </div>

          <!-- Saved Addresses list -->
          <% if (addresses.length === 0) { %>
            <div class="text-center py-10 border border-dashed border-gray-200 rounded-sm space-y-3">
              <p class="text-xs text-gray-400 font-medium">No saved addresses found. Please add a shipping address to proceed.</p>
              <button 
                type="button" 
                onclick="openAddressModal()"
                class="inline-block bg-black text-white text-[9px] font-bold tracking-widest uppercase px-5 py-2.5 rounded-sm hover:bg-gray-800 transition-colors"
              >
                Add Address
              </button>
            </div>
          <% } else { %>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <% addresses.forEach(address => { 
                const isSelected = defaultAddress ? (address._id.toString() === defaultAddress._id.toString()) : false;
              %>
                <div 
                  id="address-card-<%= address._id %>"
                  onclick="selectAddress('<%= address._id %>')"
                  class="address-card relative border rounded-sm p-5 transition-all cursor-pointer group flex flex-col justify-between min-h-[160px] <%= isSelected ? 'border-black border-2 bg-gray-50/30' : 'border-gray-100 border hover:border-black' %>"
                >
                  <!-- Selection Indicator -->
                  <div class="absolute top-4 right-4 flex items-center gap-2">
                    <% if (address.isDefault) { %>
                      <span class="text-[8px] font-bold tracking-widest text-white bg-black px-2 py-0.5 rounded-sm uppercase">
                        DEFAULT
                      </span>
                    <% } %>
                    <div class="w-4 h-4 rounded-full border border-gray-300 flex items-center justify-center bg-white">
                      <div class="w-2 h-2 rounded-full bg-black address-dot <%= isSelected ? '' : 'hidden' %>"></div>
                    </div>
                  </div>

                  <!-- Address Details -->
                  <div class="space-y-1.5 pr-12">
                    <span class="text-[8px] font-bold text-gray-400 tracking-widest uppercase bg-gray-100 px-1.5 py-0.5 rounded-sm">
                      <%= address.addressType %>
                    </span>
                    <h3 class="text-xs font-bold text-gray-900 mt-1"><%= address.fullName %></h3>
                    <p class="text-[11px] text-gray-500 font-medium leading-relaxed">
                      <%= address.address %><br>
                      <% if (address.landmark) { %>
                        <%= address.landmark %>, 
                      <% } %>
                      <%= address.city %>, <%= address.state %> - <%= address.pincode %>
                    </p>
                    <p class="text-[10px] text-gray-500 font-semibold pt-1">
                      <i class="fa-solid fa-phone text-[9px] mr-1"></i> +91 <%= address.phone %>
                    </p>
                  </div>

                  <!-- Actions -->
                  <div class="flex items-center gap-4 pt-4 border-t border-gray-50 mt-3 text-[10px] font-bold tracking-widest uppercase" onclick="event.stopPropagation();">
                    <a 
                      href="/profile/address/edit/<%= address._id %>?from=checkout" 
                      class="text-gray-400 hover:text-black transition-colors"
                    >
                      EDIT
                    </a>
                    
                    <% if (!address.isDefault) { %>
                      <a 
                        href="/profile/address/default/<%= address._id %>" 
                        class="text-gray-400 hover:text-black transition-colors"
                      >
                        SET DEFAULT
                      </a>
                    <% } %>

                    <a 
                      href="/profile/address/delete/<%= address._id %>" 
                      class="text-rose-400 hover:text-rose-600 transition-colors ml-auto"
                      onclick="return confirm('Are you sure you want to delete this address?');"
                    >
                      DELETE
                    </a>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>

        <!-- Payment Method Section -->
        <div class="border border-gray-100 rounded-sm p-6 bg-white space-y-6">
          <h2 class="text-xs font-bold tracking-widest text-gray-800 uppercase flex items-center gap-2 border-b border-gray-100 pb-4">
            <i class="fa-solid fa-wallet text-sm"></i>
            PAYMENT METHOD
          </h2>

          <div class="space-y-3">
            <!-- Cash on Delivery Option -->
            <label class="relative border-2 border-black bg-gray-50/30 rounded-sm p-5 cursor-pointer block flex items-center gap-4">
              <div class="w-4 h-4 rounded-full border border-black flex items-center justify-center bg-white">
                <div class="w-2 h-2 rounded-full bg-black"></div>
              </div>
              <div class="space-y-1">
                <span class="text-xs font-bold text-gray-900 tracking-wider">CASH ON DELIVERY (COD)</span>
                <p class="text-[10px] text-gray-500 font-medium">Pay with cash upon delivery of your order. No extra charges.</p>
              </div>
              <span class="ml-auto text-[10px] font-bold text-emerald-600 tracking-widest uppercase bg-emerald-50 px-2 py-0.5 rounded-sm">
                AVAILABLE
              </span>
            </label>

            <!-- Disabled Online Option as placeholder -->
            <div class="relative border border-gray-100 rounded-sm p-5 opacity-50 cursor-not-allowed flex items-center gap-4">
              <div class="w-4 h-4 rounded-full border border-gray-200 flex items-center justify-center bg-white"></div>
              <div class="space-y-1">
                <span class="text-xs font-bold text-gray-400 tracking-wider">ONLINE PAYMENT (UPI, CARD, NETBANKING)</span>
                <p class="text-[10px] text-gray-400 font-medium">Pay securely online using credit/debit card, UPI or Netbanking.</p>
              </div>
              <span class="ml-auto text-[10px] font-bold text-gray-400 tracking-widest uppercase bg-gray-50 px-2 py-0.5 rounded-sm">
                TEMPORARILY UNAVAILABLE
              </span>
            </div>
          </div>
        </div>

      </div>

      <!-- Right side: Bag Review & Place Order CTA (1/3 width, sticky) -->
      <div class="border border-gray-100 p-6 space-y-6 bg-white sticky top-24">
        
        <!-- Bag summary header -->
        <span class="text-xs font-bold tracking-widest block text-gray-800 border-b border-gray-100 pb-3 uppercase">
          ORDER SUMMARY
        </span>

        <!-- Product items review list -->
        <div class="max-h-[280px] overflow-y-auto divide-y divide-gray-50 pr-2">
          <% checkoutItems.forEach(item => { %>
            <div class="flex items-center gap-4 py-4 first:pt-0 last:pb-0">
              <div class="w-16 h-16 bg-gray-50 flex-shrink-0 border border-gray-100 rounded-sm overflow-hidden">
                <img src="<%= item.image || '/images/placeholder.jpg' %>" alt="Product Image" class="w-full h-full object-cover">
              </div>
              <div class="flex-grow space-y-0.5">
                <span class="text-[8px] font-bold text-gray-400 tracking-wider uppercase block">
                  <%= item.brand || 'ZIYAURA' %>
                </span>
                <h4 class="text-xs font-bold text-gray-900 line-clamp-1">
                  <%= item.name %>
                </h4>
                <% if (item.variantDetails) { %>
                  <p class="text-[9px] font-bold text-gray-400 uppercase tracking-widest">
                    <%= item.variantDetails %>
                  </p>
                <% } %>
                <div class="flex justify-between items-center pt-1">
                  <span class="text-[10px] font-bold text-gray-500">
                    Qty: <%= item.quantity %>
                  </span>
                  <span class="text-xs font-bold text-gray-800">
                    ₹<%= item.itemTotal.toLocaleString() %>
                  </span>
                </div>
              </div>
            </div>
          <% }); %>
        </div>

        <!-- Prices breakdown -->
        <div class="space-y-4 text-xs border-t border-gray-100 pt-4">
          <div class="flex justify-between items-center">
            <span class="text-gray-400 font-medium">Subtotal</span>
            <span class="font-bold text-gray-800">₹<%= subtotal.toLocaleString() %></span>
          </div>
          
          <div class="flex justify-between items-center">
            <span class="text-gray-400 font-medium">Shipping Charge</span>
            <span class="font-bold text-gray-800">
              <%= shippingCharge === 0 ? 'FREE' : '₹' + shippingCharge.toLocaleString() %>
            </span>
          </div>

          <!-- Taxes Detail -->
          <div class="flex justify-between items-center text-gray-400">
            <span class="font-medium">Estimated Taxes <span class="text-[9px] font-bold text-gray-400">(18% GST Included)</span></span>
            <span class="font-bold">₹<%= Math.round(subtotal * 0.18).toLocaleString() %></span>
          </div>

          <% if (discount > 0) { %>
            <div class="flex justify-between items-center text-emerald-600">
              <span class="font-medium">Discounts</span>
              <span class="font-bold">-₹<%= discount.toLocaleString() %></span>
            </div>
          <% } %>

          <hr class="border-gray-100">

          <div class="flex justify-between items-center text-sm">
            <span class="font-bold tracking-wider text-gray-800">GRAND TOTAL</span>
            <span class="font-extrabold text-black">₹<%= grandTotal.toLocaleString() %></span>
          </div>
        </div>

        <!-- Place Order Form -->
        <form id="checkout-form" action="/checkout/place-order" method="POST" class="pt-2">
          <input 
            type="hidden" 
            name="addressId" 
            id="selected-address-id" 
            value="<%= defaultAddress ? defaultAddress._id : (addresses.length > 0 ? addresses[0]._id : '') %>"
          >
          <input type="hidden" name="paymentMethod" value="COD">

          <button 
            type="submit" 
            id="submit-btn"
            class="w-full bg-black text-white hover:bg-gray-800 py-4 rounded-sm text-[10px] font-bold tracking-widest uppercase transition-colors"
          >
            PLACE ORDER
          </button>
        </form>

        <p class="text-[9px] text-gray-400 text-center font-medium leading-relaxed">
          By clicking Place Order you agree to our terms and conditions. Delivery takes approximately 3-5 business days.
        </p>

      </div>

    </div>

  </main>
</div>

<!-- Address Modal Overlay -->
<div 
  id="addressModal" 
  class="fixed inset-0 bg-black/40 backdrop-blur-sm hidden z-[100] flex items-center justify-center p-4"
>
  <!-- Modal Box -->
  <div class="bg-white w-full max-w-2xl rounded-sm shadow-2xl relative overflow-hidden animate-fadeIn">
    
    <!-- Scroll Container -->
    <div class="max-h-[90vh] overflow-y-auto">
      
      <!-- Header -->
      <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
        <h2 class="text-xs font-bold tracking-widest text-gray-800 uppercase">
          ADD SHIPPING ADDRESS
        </h2>
        <button onclick="closeAddressModal()" class="text-2xl text-gray-400 hover:text-black focus:outline-none">
          &times;
        </button>
      </div>

      <!-- Form -->
      <form action="/profile/add-address" method="POST" class="p-6 space-y-4" id="address-form">
        
        <!-- Full Name -->
        <div class="space-y-1">
          <label class="block text-[10px] font-bold tracking-widest text-gray-500 uppercase">
            Full Name
          </label>
          <input 
            type="text" 
            name="fullName" 
            placeholder="Enter recipient's full name" 
            required 
            autofocus
            class="w-full border border-gray-200 rounded-sm px-4 py-2.5 text-xs focus:outline-none focus:border-black"
          >
        </div>

        <!-- Phone -->
        <div class="space-y-1">
          <label class="block text-[10px] font-bold tracking-widest text-gray-500 uppercase">
            Phone Number
          </label>
          <div class="flex">
            <div class="px-3 py-2.5 border border-r-0 border-gray-200 bg-gray-50 text-xs text-gray-500 font-bold rounded-l-sm">
              +91
            </div>
            <input 
              type="text" 
              name="phone" 
              maxlength="10" 
              placeholder="Enter 10-digit number" 
              required
              pattern="[0-9]{10}"
              class="w-full border border-gray-200 rounded-r-sm px-4 py-2.5 text-xs focus:outline-none focus:border-black"
            >
          </div>
        </div>

        <!-- Address -->
        <div class="space-y-1">
          <label class="block text-[10px] font-bold tracking-widest text-gray-500 uppercase">
            Address (House No, Street)
          </label>
          <input 
            type="text" 
            name="address" 
            placeholder="Flat, House no., Building, Company, Apartment, Street" 
            required
            class="w-full border border-gray-200 rounded-sm px-4 py-2.5 text-xs focus:outline-none focus:border-black"
          >
        </div>

        <!-- Landmark -->
        <div class="space-y-1">
          <label class="block text-[10px] font-bold tracking-widest text-gray-500 uppercase">
            Landmark (Optional)
          </label>
          <input 
            type="text" 
            name="landmark" 
            placeholder="e.g. near Apollo hospital"
            class="w-full border border-gray-200 rounded-sm px-4 py-2.5 text-xs focus:outline-none focus:border-black"
          >
        </div>

        <!-- Pincode -->
        <div class="space-y-1">
          <label class="block text-[10px] font-bold tracking-widest text-gray-500 uppercase">
            PIN Code
          </label>
          <input 
            id="pincode" 
            type="text" 
            name="pincode" 
            maxlength="6" 
            placeholder="6-digit Indian PIN code" 
            required
            pattern="[0-9]{6}"
            class="w-full border border-gray-200 rounded-sm px-4 py-2.5 text-xs focus:outline-none focus:border-black"
          >
          <p id="pincodeMessage" class="text-[9px] font-bold uppercase tracking-wider text-gray-400 mt-1"></p>
        </div>

        <!-- City & State -->
        <div class="grid grid-cols-2 gap-4">
          <!-- City -->
          <div class="space-y-1">
            <label class="block text-[10px] font-bold tracking-widest text-gray-500 uppercase">
              City
            </label>
            <input 
              id="city" 
              type="text" 
              name="city" 
              placeholder="City" 
              required
              class="w-full border border-gray-200 rounded-sm px-4 py-2.5 text-xs bg-gray-50 focus:outline-none focus:border-black"
            >
          </div>

          <!-- State -->
          <div class="space-y-1">
            <label class="block text-[10px] font-bold tracking-widest text-gray-500 uppercase">
              State
            </label>
            <select 
              id="state" 
              name="state" 
              required
              class="w-full border border-gray-200 rounded-sm px-4 py-2.5 text-xs focus:outline-none focus:border-black"
            >
              <option value="">Select State</option>
            </select>
          </div>
        </div>

        <!-- Address Type -->
        <div class="space-y-2">
          <label class="block text-[10px] font-bold tracking-widest text-gray-500 uppercase">
            Address Type
          </label>
          <div class="flex gap-4">
            <label class="cursor-pointer flex items-center gap-1.5">
              <input type="radio" name="addressType" value="Home" class="accent-black" checked>
              <span class="text-xs font-medium text-gray-700">Home (All day delivery)</span>
            </label>
            <label class="cursor-pointer flex items-center gap-1.5">
              <input type="radio" name="addressType" value="Work" class="accent-black">
              <span class="text-xs font-medium text-gray-700">Work (10 AM - 5 PM)</span>
            </label>
            <label class="cursor-pointer flex items-center gap-1.5">
              <input type="radio" name="addressType" value="Other" class="accent-black">
              <span class="text-xs font-medium text-gray-700">Other</span>
            </label>
          </div>
        </div>

        <!-- Default Checkbox -->
        <label class="flex items-center gap-2 pt-2 cursor-pointer">
          <input type="checkbox" name="isDefault" value="on" class="accent-black rounded-sm">
          <span class="text-xs font-semibold text-gray-700">Set as my default shipping address</span>
        </label>

        <!-- Form Buttons -->
        <div class="flex items-center justify-end gap-4 pt-4 border-t border-gray-100 text-[10px] font-bold tracking-widest uppercase">
          <button 
            type="button" 
            onclick="closeAddressModal()"
            class="text-gray-400 hover:text-black transition-colors"
          >
            Cancel
          </button>
          <button 
            type="submit"
            class="bg-black hover:bg-gray-800 text-white px-6 py-3 rounded-sm transition-colors"
          >
            Save Address
          </button>
        </div>

      </form>

    </div>
  </div>
</div>

<%- include("../partials/toast") %>

<!-- Script Logic -->
<script>
  // Address selection logic
  function selectAddress(id) {
    document.getElementById('selected-address-id').value = id;
    
    // Update active states
    document.querySelectorAll('.address-card').forEach(card => {
      card.classList.remove('border-black', 'border-2', 'bg-gray-50/30');
      card.classList.add('border-gray-100', 'border');
    });
    
    const selectedCard = document.getElementById('address-card-' + id);
    if (selectedCard) {
      selectedCard.classList.remove('border-gray-100', 'border');
      selectedCard.classList.add('border-black', 'border-2', 'bg-gray-50/30');
    }

    // Update checkmark indicators
    document.querySelectorAll('.address-dot').forEach(dot => {
      dot.classList.add('hidden');
    });
    const selectedDot = selectedCard ? selectedCard.querySelector('.address-dot') : null;
    if (selectedDot) {
      selectedDot.classList.remove('hidden');
    }
  }

  // Address modal controls
  function openAddressModal() {
    document.getElementById('addressModal').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  // Close address modal
  function closeAddressModal() {
    document.getElementById('addressModal').classList.add('hidden');
    document.body.style.overflow = 'auto';
  }

  // Indian States population
  const indianStates = [
    "Andhra Pradesh", "Arunachal Pradesh", "Assam", "Bihar", "Chhattisgarh", "Goa", "Gujarat",
    "Haryana", "Himachal Pradesh", "Jharkhand", "Karnataka", "Kerala", "Madhya Pradesh", "Maharashtra",
    "Manipur", "Meghalaya", "Mizoram", "Nagaland", "Odisha", "Punjab", "Rajasthan", "Sikkim",
    "Tamil Nadu", "Telangana", "Tripura", "Uttar Pradesh", "Uttarakhand", "West Bengal",
    "Andaman and Nicobar Islands", "Chandigarh", "Delhi", "Jammu and Kashmir", "Ladakh", "Lakshadweep", "Puducherry"
  ];

  const stateSelect = document.getElementById('state');
  indianStates.forEach(state => {
    const option = document.createElement('option');
    option.value = state;
    option.textContent = state.toUpperCase();
    stateSelect.appendChild(option);
  });

  // Pincode Detection
  const pincodeInput = document.getElementById("pincode");
  pincodeInput.addEventListener("keyup", async () => {
    const pincode = pincodeInput.value;
    const msgEl = document.getElementById("pincodeMessage");
    if (pincode.length === 6) {
      try {
        msgEl.innerText = "Detecting location...";
        msgEl.classList.remove('text-rose-500');
        msgEl.classList.add('text-gray-400');

        const response = await fetch(`https://api.postalpincode.in/pincode/${pincode}`);
        const data = await response.json();

        if (data[0].Status === "Success" && data[0].PostOffice.length > 0) {
          const postOffice = data[0].PostOffice[0];
          document.getElementById("city").value = postOffice.District;
          document.getElementById("state").value = postOffice.State;
          msgEl.innerText = `LOCATION DETECTED: ${postOffice.District.toUpperCase()}, ${postOffice.State.toUpperCase()}`;
        } else {
          document.getElementById("city").value = "";
          document.getElementById("state").value = "";
          msgEl.innerText = "INVALID PIN CODE";
          msgEl.classList.remove('text-gray-400');
          msgEl.classList.add('text-rose-500');
        }
      } catch (err) {
        console.log(err);
        msgEl.innerText = "UNABLE TO FETCH LOCATION";
      }
    }
  });

  // Form Submission Validation
  document.getElementById('checkout-form').addEventListener('submit', function(e) {
    const addressId = document.getElementById('selected-address-id').value;
    if (!addressId) {
      e.preventDefault();
      alert('Please select or add a shipping address before placing your order.');
      return;
    }
    const submitBtn = document.getElementById('submit-btn');
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i> PLACING ORDER...';
  });
</script>

<%- include("../partials/user/footer") %>