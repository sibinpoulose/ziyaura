<%- include("../partials/user/header") %>

<div class="min-h-screen bg-gray-100 flex items-center justify-center">

  <div class="bg-white w-full max-w-md rounded-2xl shadow-sm p-10">

    <h1 class="text-3xl font-bold mb-2">

      Verify OTP

    </h1>

    <p class="text-gray-500 mb-8">

      OTP sent to:

      <span class="font-medium">

        <%= email %>

      </span>

    </p>





    <!-- VERIFY OTP FORM -->

    <form
      id="otpForm"
      action="/profile/verify-profile-otp"
      method="POST"
    >

      <input
        id="otpInput"
        type="text"
        name="otp"
        maxlength="6"
        placeholder="Enter OTP"
        required
        class="w-full border rounded-xl px-5 py-4 text-lg tracking-[10px] text-center"
      >

      <p
        id="otpError"
        class="text-red-500 text-sm mt-3 text-center"
      ></p>


      <div class="mt-4 text-center">

        <span
          id="timer"
          class="text-red-500 font-semibold"
        >

          05:00

        </span>

      </div>


      <button
        id="verifyButton"
        type="submit"
        class="w-full mt-6 bg-black text-white py-4 rounded-xl"
      >

        Verify OTP

      </button>

    </form>


    <!-- RESEND OTP FORM -->

    <form
      id="resendForm"
      action="/profile/resend-profile-otp"
      method="POST"
      class="hidden mt-4 text-center"
    >

      <button
        id="resendButton"
        type="submit"
        class="text-blue-600 font-semibold hover:text-blue-800"
      >

        Resend OTP

      </button>

    </form>

  </div>

</div>


<script>

  const otpForm =
    document.getElementById("otpForm");

  const otpInput =
    document.getElementById("otpInput");

  const otpError =
    document.getElementById("otpError");

  const verifyButton =
    document.getElementById("verifyButton");

  const resendForm =
    document.getElementById("resendForm");

  const resendButton =
    document.getElementById("resendButton");

  const timer =
    document.getElementById("timer");


  // VERIFY OTP

  otpForm.addEventListener("submit", (e) => {

    otpError.innerText = "";


    if (!/^[0-9]{6}$/.test(otpInput.value)) {

      e.preventDefault();

      otpError.innerText =
        "Enter valid 6-digit OTP";

      return;

    }


    verifyButton.innerText =
      "Verifying...";

    verifyButton.disabled = true;

  });


  // OTP TIMER

  let timeLeft = parseInt("<%= timeLeft %>") || 0;

  const updateTimerDisplay = (secondsRemaining) => {
    if (secondsRemaining <= 0) {
      clearInterval(countdown);
      timer.innerText = "OTP Expired";
      timer.classList.remove("text-red-500");
      timer.classList.add("text-gray-500");
      resendForm.classList.remove("hidden");
      return;
    }

    const minutes = Math.floor(secondsRemaining / 60);
    let seconds = secondsRemaining % 60;
    seconds = seconds < 10 ? "0" + seconds : seconds;

    timer.innerText = `${minutes}:${seconds}`;
  };

  updateTimerDisplay(timeLeft);

  const countdown = setInterval(() => {
    timeLeft--;
    updateTimerDisplay(timeLeft);
  }, 1000);


  // RESEND OTP

  resendForm.addEventListener("submit", () => {
    resendButton.innerText =
      "Sending...";

    resendButton.disabled = true;

  });

</script>

<%- include("../partials/toast") %>