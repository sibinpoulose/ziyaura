<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>Login</title>

  <script src="https://cdn.tailwindcss.com"></script>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

</head>

<body class="bg-gray-100">

  <div class="flex h-screen">

    <div class="w-1/2 bg-gray-100 flex flex-col justify-center px-20 relative">

      <h1 class="absolute top-8 left-20 text-xl font-semibold tracking-widest text-white">

        ZIYAURA

      </h1>

      <div class="mt-16">

        <p class="text-2xl text-gray-800 mb-6">

          Welcome back. Continue your journey.

        </p>

        <img src="/images/signupimage.webp" class="rounded-lg shadow-md w-full max-w-md">

      </div>

    </div>

    <div class="w-1/2 flex justify-center items-start py-10">

      <div class="bg-white p-8 rounded-lg shadow-md w-full max-w-md">

        <h2 class="text-xl font-semibold mb-4 text-center">

          Login to your account

        </h2>

        <form id="loginForm" action="/login" method="POST" class="space-y-4">

          <input id="email" type="email" name="email" placeholder="Email"
            class="w-full p-3 border rounded focus:outline-none focus:ring-2 focus:ring-blue-600" required>

          <div class="relative">

            <input type="password" id="password" name="password" placeholder="Password" required
              class="w-full p-3 border rounded focus:outline-none focus:ring-2 focus:ring-blue-600 pr-12">

            <button type="button" onclick="togglePassword()"
              class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-500">

              <i id="passwordIcon" class="fa-solid fa-eye"></i>

            </button>

          </div>

          <div class="text-right text-sm">

            <a href="/forgot-password" class="text-gray-500 hover:text-blue-600">

              Forgot password?

            </a>

          </div>

          <p id="loginError" class="text-red-500 text-sm text-center"></p>

          <% if (success) { %>

            <div class="bg-green-100 text-green-700 p-3 rounded text-sm text-center">

              <%= success %>

            </div>

            <% } %>


              <% if (error) { %>

                <div class="bg-red-100 text-red-700 p-3 rounded text-sm text-center">

                  <%= error %>

                </div>

                <% } %>

                  <button id="loginButton" class="w-full bg-blue-700 hover:bg-blue-800 text-white py-3 rounded">

                    Login

                  </button>

        </form>

        <div class="flex items-center my-5">

          <div class="flex-grow h-px bg-gray-300"></div>

          <span class="px-3 text-sm text-gray-500">

            or continue with

          </span>

          <div class="flex-grow h-px bg-gray-300"></div>

        </div>

        <div class="space-y-3">

          <a href="/auth/google"
            class="w-full flex items-center justify-center gap-3 border border-gray-300 py-3 rounded hover:bg-gray-100">

            <img src="/images/googlelogo.jpg" class="w-7 h-7">

            <span class="text-sm font-medium text-gray-700">

              Continue with Google

            </span>

          </a>

          <!-- <a
            href="/auth/facebook"
            class="w-full flex items-center justify-center gap-3 border border-gray-300 py-3 rounded hover:bg-gray-100"
          >

            <img
              src="/images/facebooklogo.png"
              class="w-5 h-5"
            >

            <span class="text-sm font-medium text-gray-700">

              Continue with Facebook

            </span>

          </a> -->

        </div>

        <p class="text-center mt-4 text-sm">

          Don't have an account?

          <a href="/signup" class="text-blue-600">

            Sign up

          </a>

        </p>

      </div>

    </div>

  </div>

  <script>

    function togglePassword() {

      const input =
        document.getElementById("password");

      const icon =
        document.getElementById("passwordIcon");


      if (input.type === "password") {

        input.type = "text";

        icon.classList.remove("fa-eye");

        icon.classList.add("fa-eye-slash");

      }

      else {

        input.type = "password";

        icon.classList.remove("fa-eye-slash");

        icon.classList.add("fa-eye");

      }

    }


    const loginForm =
      document.getElementById("loginForm");

    const emailInput =
      document.getElementById("email");

    const passwordInput =
      document.getElementById("password");

    const loginError =
      document.getElementById("loginError");

    const loginButton =
      document.getElementById("loginButton");


    loginForm.addEventListener("submit", (e) => {

      loginError.innerText = "";


      if (!emailInput.value.trim()) {

        e.preventDefault();

        loginError.innerText =
          "Email is required";

        return;

      }


      const emailPattern =
        /^[^ ]+@[^ ]+\.[a-z]{2,3}$/;

      if (!emailInput.value.match(emailPattern)) {

        e.preventDefault();

        loginError.innerText =
          "Enter valid email";

        return;

      }


      if (!passwordInput.value.trim()) {

        e.preventDefault();

        loginError.innerText =
          "Password is required";

        return;

      }


      loginButton.innerText =
        "Logging in...";

      loginButton.disabled = true;

    });

  </script>

</body>

</html>