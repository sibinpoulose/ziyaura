<%- include("../partials/user/header") %>

    <div class="bg-gray-100 min-h-screen py-10">

        <div class="max-w-7xl mx-auto px-4 md:px-6">

            <!-- Heading -->
            <div class="max-w-[1440px] mx-auto px-4 md:px-6">

                <div class="flex flex-col lg:flex-row gap-8">

                    <!-- Sidebar -->

                    <%- include("../partials/user/sidebar") %>


                        <!-- Main Content -->

                        <div class="flex-1">
                            <div class="flex items-center justify-between mb-10">

                                <div>

                                    <h1 class="text-4xl font-bold text-gray-900">
                                        My Addresses
                                    </h1>

                                    <p class="text-gray-500 mt-2">
                                        Manage your shipping addresses
                                    </p>


                                </div>

                                <a href="/profile?openAddress=true#address-section"
                                    class="bg-black text-white px-6 py-3 rounded-xl">

                                    Add Address

                                </a>

                            </div>


                            <!-- Address Grid -->

                            <% if (addresses.length> 0) { %>

                                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">

                                    <% addresses.forEach((address)=> { %>

                                        <div class="bg-white rounded-2xl border shadow-sm p-6 relative">

                                            <!-- Default Badge -->

                                            <% if (address.isDefault) { %>

                                                <span
                                                    class="absolute top-5 right-5 bg-black text-white text-xs px-3 py-1 rounded-full">

                                                    DEFAULT

                                                </span>

                                                <% } %>


                                                    <!-- Name -->

                                                    <div class="mb-5">

                                                        <div class="flex items-center justify-between">

                                                            <h2 class="text-xl font-bold text-gray-900">

                                                                <%= address.fullName %>

                                                            </h2>

                                                            <span class="text-sm text-gray-500">

                                                                <%= address.addressType %>

                                                            </span>

                                                        </div>

                                                        <p class="text-gray-500 mt-1">

                                                            +91 <%= address.phone %>

                                                        </p>

                                                    </div>


                                                    <!-- Address -->

                                                    <div class="space-y-2 text-gray-700 text-[15px] leading-relaxed">

                                                        <p>
                                                            <%= address.address %>
                                                        </p>

                                                        <% if (address.landmark) { %>

                                                            <p>
                                                                <%= address.landmark %>
                                                            </p>

                                                            <% } %>

                                                                <p>
                                                                    <%= address.city %>, <%= address.state %>
                                                                </p>

                                                                <p>
                                                                    <%= address.pincode %>
                                                                </p>

                                                                <p>
                                                                    India
                                                                </p>

                                                    </div>


                                                    <!-- Buttons -->

                                                    <div class="flex items-center gap-3 mt-8">

                                                        <!-- Edit -->

                                                        <a href="/profile/address/edit/<%= address._id %>"
                                                            class="flex-1 border rounded-xl py-3 text-center font-medium hover:bg-gray-50 transition">

                                                            Edit

                                                        </a>


                                                        <!-- Delete -->

                                                        <a href="/profile/address/delete/<%= address._id %>"
                                                            onclick="return confirm('Delete this address?')"
                                                            class="flex-1 bg-red-500 text-white rounded-xl py-3 text-center font-medium hover:bg-red-600 transition">

                                                            Delete

                                                        </a>

                                                    </div>


                                                    <!-- Set Default -->

                                                    <% if (!address.isDefault) { %>

                                                        <a href="/profile/address/default/<%= address._id %>"
                                                            class="block text-center mt-5 text-sm font-medium text-gray-500 hover:text-black">

                                                            Set as default address

                                                        </a>

                                                        <% } %>

                                        </div>

                                        <% }) %>

                                </div>

                                <% } else { %>

                                    <!-- Empty -->

                                    <div class="bg-white rounded-2xl border p-16 text-center">

                                        <h2 class="text-2xl font-semibold text-gray-900">

                                            No Addresses Added

                                        </h2>

                                        <p class="text-gray-500 mt-2">

                                            Add your first address from profile page

                                        </p>

                                    </div>

                                    <% } %>

                        </div>

                </div>
            </div>
        </div>
    </div>

    <%- include("../partials/user/footer") %>
    <%- include("../partials/toast") %>