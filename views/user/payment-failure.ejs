<%- include("../partials/user/header") %>

<!-- Premium Professional Payment Failure Page -->
<div class="bg-white min-h-screen py-16 px-4 flex items-center justify-center">
  <div class="max-w-xl w-full border border-gray-100 rounded-sm p-8 md:p-12 shadow-sm text-center space-y-8 animate-fadeIn">
    
    <!-- Status Icon Wrapper -->
    <div class="relative w-24 h-24 mx-auto flex items-center justify-center">
      <div class="absolute inset-0 bg-rose-50 rounded-full animate-ping opacity-75"></div>
      <div class="relative w-20 h-20 bg-rose-500 rounded-full flex items-center justify-center text-white shadow-md">
        <i class="fa-solid fa-triangle-exclamation text-3xl"></i>
      </div>
    </div>

    <!-- Alert details header -->
    <div class="space-y-3">
      <span class="text-[10px] font-bold tracking-widest text-rose-500 uppercase bg-rose-50 px-3 py-1 rounded-sm">
        Transaction Unsuccessful
      </span>
      <h1 class="text-xl md:text-2xl font-bold tracking-tight text-gray-900 uppercase">
        PAYMENT VERIFICATION FAILED
      </h1>
      <p class="text-xs text-gray-400 font-medium max-w-sm mx-auto leading-relaxed">
        We encountered a problem while processing your payment. Your order has been placed but remains in a "Pending Payment" state.
      </p>
    </div>

    <!-- Order summary card -->
    <div class="bg-gray-50 border border-gray-100 rounded-sm p-5 text-left space-y-2 text-xs font-semibold text-gray-700">
      <div class="flex justify-between">
        <span class="text-gray-400">Order ID:</span>
        <span class="text-gray-800"><%= order.orderId %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-gray-400">Payment Status:</span>
        <span class="text-rose-500 uppercase"><%= order.paymentStatus %></span>
      </div>
      <div class="flex justify-between border-t border-gray-200/60 pt-2 text-sm font-bold">
        <span class="text-gray-900">Grand Total:</span>
        <span class="text-black">₹<%= order.grandTotal.toLocaleString() %></span>
      </div>
    </div>

    <!-- Troubleshooting checklist card -->
    <div class="bg-gray-50/50 border border-gray-100 rounded-sm p-5 text-left space-y-3">
      <h3 class="text-[10px] font-bold tracking-widest text-gray-800 uppercase flex items-center gap-2">
        <i class="fa-solid fa-circle-question text-rose-500 text-xs"></i>
        Why did this happen?
      </h3>
      <ul class="text-[11px] text-gray-500 space-y-2 font-medium">
        <li class="flex items-start gap-2">
          <span class="text-rose-500 font-bold">•</span>
          <span>The payment gateway connection timed out or the modal was closed.</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-rose-500 font-bold">•</span>
          <span>Insufficient funds or security limits set on your account/card.</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-rose-500 font-bold">•</span>
          <span>The transaction was rejected by your bank or payment issuer.</span>
        </li>
      </ul>
    </div>

    <!-- Actions block -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center pt-4">
      <button 
        onclick="retryPayment()" 
        id="retry-btn"
        class="bg-black hover:bg-gray-800 text-white font-bold text-[10px] uppercase tracking-widest px-8 py-4 transition-all rounded-sm shadow-sm flex items-center justify-center gap-2"
      >
        <i class="fa-solid fa-arrow-rotate-right"></i>
        Retry Payment
      </button>
      <a 
        href="/profile/orders" 
        class="border border-gray-200 hover:border-black text-gray-500 hover:text-black font-bold text-[10px] uppercase tracking-widest px-8 py-4 transition-all rounded-sm flex items-center justify-center gap-2"
      >
        <i class="fa-solid fa-box-open"></i>
        View Order History
      </a>
    </div>

    <!-- Customer Support footer -->
    <p class="text-[9px] text-gray-400 font-medium pt-4 border-t border-gray-50">
      Need assistance? Contact our luxury support helpline at <span class="font-bold text-gray-700">support@ziyaura.com</span>
    </p>

  </div>
</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
  function retryPayment() {
    const retryBtn = document.getElementById('retry-btn');
    retryBtn.disabled = true;
    retryBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i> INITIATING...';

    fetch('/checkout/retry-payment/<%= order._id %>', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' }
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        const options = {
          key: data.key_id,
          amount: data.amount,
          currency: "INR",
          name: "ZIYAURA Store",
          description: "Retry Purchase Order Payment",
          order_id: data.razorpayOrderId,
          handler: function (response) {
            fetch('/checkout/verify-payment', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                razorpay_order_id: response.razorpay_order_id,
                razorpay_payment_id: response.razorpay_payment_id,
                razorpay_signature: response.razorpay_signature,
                orderId: data.orderId
              })
            })
            .then(res => res.json())
            .then(verifData => {
              if(verifData.success) {
                window.location.href = `/order-success/${data.orderId}`;
              } else {
                window.location.reload();
              }
            });
          },
          prefill: {
            name: data.user.name,
            email: data.user.email,
            contact: data.user.phone
          },
          theme: { color: "#000000" },
          modal: {
            ondismiss: function() {
              window.location.reload();
            }
          }
        };
        const rzp = new Razorpay(options);
        rzp.open();
      } else {
        alert(data.message || 'Failed to initiate repayment.');
        retryBtn.disabled = false;
        retryBtn.innerHTML = '<i class="fa-solid fa-arrow-rotate-right"></i> Retry Payment';
      }
    })
    .catch(err => {
      console.error(err);
      alert('Network error. Please try again.');
      retryBtn.disabled = false;
      retryBtn.innerHTML = '<i class="fa-solid fa-arrow-rotate-right"></i> Retry Payment';
    });
  }
</script>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fadeIn {
    animation: fadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>

<%- include("../partials/user/footer") %>
