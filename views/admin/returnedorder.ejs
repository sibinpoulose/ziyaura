<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Return Requests | ZIYAURA Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body {
            font-family: 'Inter', sans-serif;
            background-color: #F3F6F9;
        }
        .custom-shadow {
            box-shadow: 0 2px 15px rgba(0,0,0,0.03);
        }
    </style>
</head>
<body class="flex min-h-screen">

    <%- include("../partials/admin/navbar")%>

    <!-- Main Content -->
    <main class="ml-64 flex-grow p-10">
        
        <!-- Header -->
        <header class="flex justify-between items-center mb-10">
            <div>
                <h2 class="text-2xl font-bold text-gray-800">Return Requests</h2>
                <p class="text-xs text-gray-400 font-medium mt-1">Review and process user returned items & refund to wallet</p>
            </div>
        </header>

        <!-- Requests list table -->
        <section class="bg-white rounded-2xl custom-shadow overflow-hidden">
            <div class="p-8 pb-4 border-b border-gray-50">
                <h4 class="text-sm font-bold text-gray-800">Pending Approvals</h4>
            </div>
            <table class="w-full text-left">
                <thead>
                  <tr class="text-[11px] font-bold text-gray-400 border-b border-gray-50 uppercase tracking-wider">
                    <th class="px-8 py-5">Order ID</th>
                    <th class="px-6 py-5">Customer</th>
                    <th class="px-6 py-5">Product Name</th>
                    <th class="px-6 py-5">Return Reason</th>
                    <th class="px-6 py-5">Estimated Refund</th>
                    <th class="px-8 py-5 text-right">Actions</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-50 text-xs font-semibold text-gray-700">
                  <% if (orders.length === 0) { %>
                    <tr>
                      <td colspan="6" class="text-center py-10 font-bold text-gray-400 uppercase tracking-wider">No return requests found.</td>
                    </tr>
                  <% } else { %>
                    <% orders.forEach(order => { %>
                      <% order.products.forEach(item => { %>
                        <% if (item.orderStatus === 'Return Requested') { %>
                          <tr class="hover:bg-gray-50/50 transition-colors">
                            <td class="px-8 py-5 text-blue-500 font-bold"><%= order.orderId %></td>
                            <td class="px-6 py-5 text-gray-500"><%= order.userId ? order.userId.name : 'Guest User' %></td>
                            <td class="px-6 py-5 text-gray-900"><%= item.name %> <p class="text-[10px] text-gray-400">Qty: <%= item.quantity %></p></td>
                            <td class="px-6 py-5 text-gray-500 italic max-w-xs truncate" title="<%= item.returnReason %>"><%= item.returnReason %></td>
                            <td class="px-6 py-5 text-emerald-600 font-bold">₹<%= (item.total - (order.discount * (item.total / order.subtotal))).toFixed(2) %></td>
                            <td class="px-8 py-5 text-right space-x-2">
                              <button 
                                onclick="processReturn('<%= order._id %>', '<%= item._id %>', 'accept')" 
                                class="bg-emerald-500 hover:bg-emerald-600 text-white font-bold text-[10px] px-3.5 py-2 uppercase tracking-widest rounded-lg transition-colors"
                              >
                                Accept
                              </button>
                              <button 
                                onclick="processReturn('<%= order._id %>', '<%= item._id %>', 'reject')" 
                                class="bg-rose-500 hover:bg-rose-600 text-white font-bold text-[10px] px-3.5 py-2 uppercase tracking-widest rounded-lg transition-colors"
                              >
                                Reject
                              </button>
                            </td>
                          </tr>
                        <% } %>
                      <% }) %>
                    <% }) %>
                  <% } %>
                </tbody>
            </table>
        </section>

    </main>

    <script>
      function processReturn(orderId, itemId, action) {
        Swal.fire({
          title: 'Are you sure?',
          text: `Are you sure you want to ${action} this return request?`,
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#3085d6',
          cancelButtonColor: '#d33',
          confirmButtonText: 'Yes, proceed!'
        }).then((result) => {
          if (result.isConfirmed) {
            fetch('/admin/returns/process', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ orderId, itemId, action })
            })
            .then(res => res.json())
            .then(data => {
              if(data.success) {
                Swal.fire({
                  title: 'Success!',
                  text: data.message,
                  icon: 'success',
                  confirmButtonText: 'OK'
                }).then(() => {
                  window.location.reload();
                });
              } else {
                Swal.fire({
                  title: 'Error!',
                  text: data.message || 'Error occurred.',
                  icon: 'error',
                  confirmButtonText: 'OK'
                });
              }
            })
            .catch(err => {
              console.error(err);
              Swal.fire({
                title: 'Error!',
                text: 'Something went wrong.',
                icon: 'error',
                confirmButtonText: 'OK'
              });
            });
          }
        });
      }
    </script>
</body>
</html>