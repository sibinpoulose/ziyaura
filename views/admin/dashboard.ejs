<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard | ZIYAURA</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body {
            font-family: 'Inter', sans-serif;
            background-color: #F3F6F9;
        }
        .sidebar-item-active {
            background-color: #ffffff;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            color: #3b82f6;
            border-radius: 0.75rem;
        }
        .custom-shadow {
            box-shadow: 0 2px 15px rgba(0,0,0,0.03);
        }
        .progress-bar {
            transition: width 1s ease-in-out;
        }
    </style>
</head>
<body class="flex min-h-screen">

    <%- include("../partials/admin/navbar")%>

    <!-- Main Content -->
    <main class="ml-64 flex-grow p-10">
        
        <!-- Top Bar -->
        <header class="flex justify-between items-center mb-10">
            <div>
                <h2 class="text-2xl font-bold text-gray-800">Dashboard</h2>
            </div>
            <div class="flex items-center gap-3">
                <div class="text-right">
                    <p class="text-xs font-bold text-gray-800 tracking-wide uppercase leading-tight">SIBIN</p>
                    <p class="text-[10px] text-gray-400 font-medium">Admin</p>
                </div>
                <div class="w-10 h-10 rounded-full bg-[#4ade80] flex items-center justify-center text-white">
                    <i class="fa-solid fa-user text-sm"></i>
                </div>
            </div>
        </header>

        <!-- KPI Cards -->
        <section class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="bg-white p-8 rounded-2xl custom-shadow">
                <p class="text-xs font-medium text-gray-400 mb-3 tracking-wide">Overall Sales Revenue</p>
                <h3 class="text-2xl font-bold text-gray-800">₹<%= totalRevenue.toLocaleString() %></h3>
            </div>
            <div class="bg-white p-8 rounded-2xl custom-shadow">
                <p class="text-xs font-medium text-gray-400 mb-3 tracking-wide">Total Discount Offered</p>
                <h3 class="text-2xl font-bold text-gray-800">₹<%= totalDiscount.toLocaleString() %></h3>
                <p class="text-[10px] text-gray-400 mt-2">Coupon deductions applied</p>
            </div>
            <div class="bg-white p-8 rounded-2xl custom-shadow">
                <p class="text-xs font-medium text-gray-400 mb-3 tracking-wide">Overall Orders Placed</p>
                <h3 class="text-2xl font-bold text-gray-800"><%= totalOrdersCount %></h3>
                <p class="text-[10px] text-gray-400 mt-2">Total checkout submissions</p>
            </div>
        </section>

        <!-- Analytics Row -->
        <section class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
            <!-- Revenue Chart Area -->
            <div class="lg:col-span-2 bg-white p-8 rounded-2xl custom-shadow">
                <div class="flex justify-between items-start mb-10">
                    <div>
                        <p class="text-sm font-bold text-gray-800 mb-1">Monthly Revenue Statistics</p>
                        <h4 class="text-2xl font-bold text-gray-800">₹<%= totalRevenue.toLocaleString() %></h4>
                    </div>
                </div>
                
                <!-- Chart Bars Loop -->
                <div class="flex items-end justify-between h-48 px-2">
                    <% if (monthlyStats.length === 0) { %>
                        <div class="text-center w-full text-xs text-gray-400">No monthly sales data available.</div>
                    <% } else { %>
                        <% monthlyStats.forEach(stat => { 
                            const maxVal = Math.max(...monthlyStats.map(s => s.revenue)) || 1;
                            const hPercent = (stat.revenue / maxVal) * 120;
                        %>
                        <div class="flex flex-col items-center gap-4 w-full" title="Revenue: ₹<%= stat.revenue.toLocaleString() %>">
                            <div class="w-5 bg-[#49B6BB] rounded-t-sm" style="height: <%= Math.max(8, hPercent) %>px"></div>
                            <span class="text-[9px] text-gray-400 font-bold uppercase"><%= stat._id.month %>/<%= stat._id.year %></span>
                        </div>
                        <% }); %>
                    <% } %>
                </div>
            </div>

            <!-- Most Sold Categories (Top 5) -->
            <div class="bg-white p-8 rounded-2xl custom-shadow">
                <h4 class="text-sm font-bold text-gray-800 mb-8">Best Selling Categories (Top 5)</h4>
                <div class="space-y-6">
                    <% if(bestSellingCategories.length === 0) { %>
                        <p class="text-center text-xs text-gray-400 font-bold uppercase">No records found</p>
                    <% } else { %>
                        <% 
                        const maxSales = bestSellingCategories[0] ? bestSellingCategories[0].quantitySold : 1;
                        bestSellingCategories.slice(0, 5).forEach(c => { 
                            const pct = Math.round((c.quantitySold / maxSales) * 100);
                        %>
                            <div class="space-y-2">
                                <div class="flex justify-between text-[10px] font-bold tracking-tight">
                                    <span class="text-gray-800 uppercase"><%= c.categoryName %></span>
                                    <span class="text-gray-900"><%= c.quantitySold %> units</span>
                                </div>
                                <div class="w-full bg-blue-50 h-2 rounded-full overflow-hidden">
                                    <div class="bg-[#3b82f6] h-full progress-bar" style="width: <%= pct %>%"></div>
                                </div>
                            </div>
                        <% }); %>
                    <% } %>
                </div>
            </div>
        </section>

        <!-- Latest Orders Table -->
        <section class="bg-white rounded-2xl custom-shadow overflow-hidden">
            <div class="p-8 pb-4">
                <h4 class="text-sm font-bold text-gray-800">Latest Orders</h4>
            </div>
            <table class="w-full text-left">
                <thead>
                    <tr class="text-[11px] font-bold text-gray-400 border-b border-gray-50 uppercase tracking-wider">
                        <th class="px-8 py-5 flex items-center gap-2"><div class="w-4 h-4 bg-blue-500 rounded-sm flex items-center justify-center"><div class="w-2 h-0.5 bg-white"></div></div> Order ID</th>
                        <th class="px-6 py-5">Product</th>
                        <th class="px-6 py-5">Date <i class="fa-solid fa-caret-down ml-1"></i></th>
                        <th class="px-6 py-5">Customer</th>
                        <th class="px-6 py-5">Total <i class="fa-solid fa-caret-down ml-1"></i></th>
                        <th class="px-6 py-5">Payment <i class="fa-solid fa-caret-down ml-1"></i></th>
                        <th class="px-6 py-5">Status <i class="fa-solid fa-caret-down ml-1"></i></th>
                        <th class="px-8 py-5 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                    <% for(let i=0; i<3; i++) { %>
                    <tr class="group hover:bg-gray-50 transition-colors">
                        <td class="px-8 py-5">
                            <div class="flex items-center gap-3">
                                <div class="w-4 h-4 bg-gray-100 rounded-sm"></div>
                                <span class="text-xs font-bold text-blue-500">302012</span>
                            </div>
                        </td>
                        <td class="px-6 py-5">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-lg overflow-hidden bg-gray-100">
                                    <!-- Use a generic placeholder for the jewelry image -->
                                    <div class="w-full h-full bg-gray-300 flex items-center justify-center text-gray-500 text-[10px] italic">Chain</div>
                                </div>
                                <div>
                                    <p class="text-[11px] font-bold text-gray-800 uppercase leading-none mb-1">Silver Chain</p>
                                    <p class="text-[9px] text-gray-400 font-medium">+3 Products</p>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-5 text-xs text-gray-500 font-medium tracking-tight">29 Dec 2025</td>
                        <td class="px-6 py-5 text-xs text-gray-500 font-medium">Josh Wisley</td>
                        <td class="px-6 py-5 text-xs text-gray-900 font-bold tracking-tight">₹59000</td>
                        <td class="px-6 py-5"></td>
                        <td class="px-6 py-5">
                            <span class="bg-pink-50 text-purple-500 px-4 py-1.5 rounded-lg text-[10px] font-bold tracking-wide">Processing</span>
                        </td>
                        <td class="px-8 py-5 text-right">
                            <div class="flex justify-end gap-3 text-gray-300">
                                <button class="hover:text-blue-500 transition-colors"><i class="fa-solid fa-pencil"></i></button>
                                <button class="hover:text-red-500 transition-colors"><i class="fa-solid fa-trash-can"></i></button>
                            </div>
                        </td>
                    </tr>
                    <% } %>
                </tbody>
            </table>
        </section>

        <!-- Top Selling Analytics (Top 10 lists) -->
        <section class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-8">
            <!-- Products -->
            <div class="bg-white p-8 rounded-2xl custom-shadow h-full">
                <h4 class="text-sm font-bold text-gray-800 mb-6 border-b border-gray-50 pb-3 uppercase tracking-wider">Top 10 Best Selling Products</h4>
                <ul class="divide-y divide-gray-50 text-xs font-semibold text-gray-700">
                    <% if (bestSellingProducts.length === 0) { %>
                        <li class="py-4 text-center text-gray-400 font-bold uppercase">No product data</li>
                    <% } else { %>
                        <% bestSellingProducts.forEach((p, index) => { %>
                            <li class="py-3 flex justify-between items-center">
                                <span class="truncate pr-4"><%= index + 1 %>. <%= p.productName %></span>
                                <span class="bg-blue-50 text-blue-600 px-2 py-0.5 rounded text-[10px] font-bold"><%= p.quantitySold %> units</span>
                            </li>
                        <% }) %>
                    <% } %>
                </ul>
            </div>
            
            <!-- Categories -->
            <div class="bg-white p-8 rounded-2xl custom-shadow h-full">
                <h4 class="text-sm font-bold text-gray-800 mb-6 border-b border-gray-50 pb-3 uppercase tracking-wider">Top 10 Best Selling Categories</h4>
                <ul class="divide-y divide-gray-50 text-xs font-semibold text-gray-700">
                    <% if (bestSellingCategories.length === 0) { %>
                        <li class="py-4 text-center text-gray-400 font-bold uppercase">No category data</li>
                    <% } else { %>
                        <% bestSellingCategories.forEach((c, index) => { %>
                            <li class="py-3 flex justify-between items-center">
                                <span class="truncate pr-4"><%= index + 1 %>. <%= c.categoryName %></span>
                                <span class="bg-emerald-50 text-emerald-600 px-2 py-0.5 rounded text-[10px] font-bold"><%= c.quantitySold %> units</span>
                            </li>
                        <% }) %>
                    <% } %>
                </ul>
            </div>

            <!-- Brands -->
            <div class="bg-white p-8 rounded-2xl custom-shadow h-full">
                <h4 class="text-sm font-bold text-gray-800 mb-6 border-b border-gray-50 pb-3 uppercase tracking-wider">Top 10 Best Selling Brands</h4>
                <ul class="divide-y divide-gray-50 text-xs font-semibold text-gray-700">
                    <% if (bestSellingBrands.length === 0) { %>
                        <li class="py-4 text-center text-gray-400 font-bold uppercase">No brand data</li>
                    <% } else { %>
                        <% bestSellingBrands.forEach((b, index) => { %>
                            <li class="py-3 flex justify-between items-center">
                                <span class="truncate pr-4"><%= index + 1 %>. <%= b.brandName || 'Generics / Other' %></span>
                                <span class="bg-indigo-50 text-indigo-600 px-2 py-0.5 rounded text-[10px] font-bold"><%= b.quantitySold %> units</span>
                            </li>
                        <% }) %>
                    <% } %>
                </ul>
            </div>
        </section>

    </main>

</body>
</html>