<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard | ZIYAURA</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body {
            font-family: 'Inter', sans-serif;
            background-color: #F3F6F9;
        }
        .sidebar-item-active {
            background-color: #ffffff;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            color: #3b82f6;
            border-radius: 0.75rem;
        }
        .custom-shadow {
            box-shadow: 0 2px 15px rgba(0,0,0,0.03);
        }
        .progress-bar {
            transition: width 1s ease-in-out;
        }
    </style>
</head>
<body class="flex min-h-screen">

    <%- include("../partials/admin/navbar")%>

    <!-- Main Content -->
    <main class="ml-64 flex-grow p-10">
        
        <!-- Top Bar -->
        <header class="flex justify-between items-center mb-8">
            <div>
                <h2 class="text-2xl font-bold text-gray-800">Dashboard</h2>
                <p class="text-xs text-gray-400 font-medium mt-1">Real-time store performance analytics and sales trends</p>
            </div>
            <div class="flex items-center gap-3">
                <div class="text-right">
                    <p class="text-xs font-bold text-gray-800 tracking-wide uppercase leading-tight">SIBIN</p>
                    <p class="text-[10px] text-gray-400 font-medium">Admin</p>
                </div>
                <div class="w-10 h-10 rounded-full bg-[#4ade80] flex items-center justify-center text-white">
                    <i class="fa-solid fa-user text-sm"></i>
                </div>
            </div>
        </header>

        <!-- Date-Wise Filters Section -->
        <section class="bg-white p-6 rounded-2xl custom-shadow mb-8">
            <form action="/admin/dashboard" method="GET" class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
                <div class="space-y-1.5">
                    <label class="block text-[10px] font-bold text-gray-400 tracking-wider uppercase">Quick Presets</label>
                    <select name="filterType" onchange="this.form.submit()" class="w-full border border-gray-200 text-xs px-3 py-2.5 focus:outline-none focus:border-blue-500 rounded-lg bg-white font-medium">
                        <option value="" <%= !filterType ? 'selected' : '' %>>Custom Date Range</option>
                        <option value="daily" <%= filterType === 'daily' ? 'selected' : '' %>>Daily (Today)</option>
                        <option value="weekly" <%= filterType === 'weekly' ? 'selected' : '' %>>Weekly (Last 7 Days)</option>
                        <option value="monthly" <%= filterType === 'monthly' ? 'selected' : '' %>>Monthly (Current Month)</option>
                        <option value="yearly" <%= filterType === 'yearly' ? 'selected' : '' %>>Yearly (Current Year)</option>
                    </select>
                </div>
                <div class="space-y-1.5">
                    <label class="block text-[10px] font-bold text-gray-400 tracking-wider uppercase">Start Date</label>
                    <input type="date" name="startDate" value="<%= startDate %>" class="w-full border border-gray-200 text-xs px-3 py-2 focus:outline-none focus:border-blue-500 rounded-lg font-medium">
                </div>
                <div class="space-y-1.5">
                    <label class="block text-[10px] font-bold text-gray-400 tracking-wider uppercase">End Date</label>
                    <input type="date" name="endDate" value="<%= endDate %>" class="w-full border border-gray-200 text-xs px-3 py-2 focus:outline-none focus:border-blue-500 rounded-lg font-medium">
                </div>
                <div class="flex gap-2">
                    <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white text-[10px] font-bold tracking-widest uppercase px-4 py-2.5 rounded-lg transition-colors w-full">
                        <i class="fa-solid fa-filter mr-1"></i> Filter
                    </button>
                    <a href="/admin/dashboard" class="bg-gray-100 hover:bg-gray-200 text-gray-600 text-[10px] font-bold tracking-widest uppercase px-4 py-2.5 rounded-lg transition-colors w-full text-center flex items-center justify-center">
                        Reset
                    </a>
                </div>
            </form>
        </section>

        <!-- KPI Cards -->
        <section class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="bg-white p-8 rounded-2xl custom-shadow">
                <p class="text-xs font-medium text-gray-400 mb-3 tracking-wide">Overall Sales Revenue</p>
                <h3 class="text-2xl font-bold text-gray-800">₹<%= totalRevenue.toLocaleString() %></h3>
            </div>
            <div class="bg-white p-8 rounded-2xl custom-shadow">
                <p class="text-xs font-medium text-gray-400 mb-3 tracking-wide">Total Discount Offered</p>
                <h3 class="text-2xl font-bold text-gray-800">₹<%= totalDiscount.toLocaleString() %></h3>
                <p class="text-[10px] text-gray-400 mt-2">Coupon deductions applied</p>
            </div>
            <div class="bg-white p-8 rounded-2xl custom-shadow">
                <p class="text-xs font-medium text-gray-400 mb-3 tracking-wide">Overall Orders Placed</p>
                <h3 class="text-2xl font-bold text-gray-800"><%= totalOrdersCount %></h3>
                <p class="text-[10px] text-gray-400 mt-2">Total checkout submissions</p>
            </div>
        </section>

        <!-- Analytics Row -->
        <section class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
            <!-- Revenue Line Chart Area -->
            <div class="lg:col-span-2 bg-white p-8 rounded-2xl custom-shadow">
                <div class="flex justify-between items-start mb-6">
                    <div>
                        <p class="text-sm font-bold text-gray-800 mb-1">Sales Revenue Trend (Line Graph)</p>
                        <h4 class="text-2xl font-bold text-gray-800">₹<%= totalRevenue.toLocaleString() %></h4>
                    </div>
                </div>
                
                <!-- Line Chart Container -->
                <div class="relative w-full h-64">
                    <canvas id="revenueLineChart"></canvas>
                </div>
            </div>

            <!-- Most Sold Categories (Top 5) -->
            <div class="bg-white p-8 rounded-2xl custom-shadow">
                <h4 class="text-sm font-bold text-gray-800 mb-8">Best Selling Categories (Top 5)</h4>
                <div class="space-y-6">
                    <% if(bestSellingCategories.length === 0) { %>
                        <p class="text-center text-xs text-gray-400 font-bold uppercase">No records found</p>
                    <% } else { %>
                        <% 
                        const maxSales = bestSellingCategories[0] ? bestSellingCategories[0].quantitySold : 1;
                        bestSellingCategories.slice(0, 5).forEach(c => { 
                            const pct = Math.round((c.quantitySold / maxSales) * 100);
                        %>
                            <div class="space-y-2">
                                <div class="flex justify-between text-[10px] font-bold tracking-tight">
                                    <span class="text-gray-800 uppercase"><%= c.categoryName %></span>
                                    <span class="text-gray-900"><%= c.quantitySold %> units</span>
                                </div>
                                <div class="w-full bg-blue-50 h-2 rounded-full overflow-hidden">
                                    <div class="bg-[#3b82f6] h-full progress-bar" style="width: <%= pct %>%"></div>
                                </div>
                            </div>
                        <% }); %>
                    <% } %>
                </div>
            </div>
        </section>

        <!-- Top Selling Analytics (Top 10 lists) -->
        <section class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-8">
            <!-- Products -->
            <div class="bg-white p-8 rounded-2xl custom-shadow h-full">
                <h4 class="text-sm font-bold text-gray-800 mb-6 border-b border-gray-50 pb-3 uppercase tracking-wider">Top 10 Best Selling Products</h4>
                <ul class="divide-y divide-gray-50 text-xs font-semibold text-gray-700">
                    <% if (bestSellingProducts.length === 0) { %>
                        <li class="py-4 text-center text-gray-400 font-bold uppercase">No product data</li>
                    <% } else { %>
                        <% bestSellingProducts.forEach((p, index) => { %>
                            <li class="py-3 flex justify-between items-center">
                                <span class="truncate pr-4"><%= index + 1 %>. <%= p.productName %></span>
                                <span class="bg-blue-50 text-blue-600 px-2 py-0.5 rounded text-[10px] font-bold"><%= p.quantitySold %> units</span>
                            </li>
                        <% }) %>
                    <% } %>
                </ul>
            </div>
            
            <!-- Categories -->
            <div class="bg-white p-8 rounded-2xl custom-shadow h-full">
                <h4 class="text-sm font-bold text-gray-800 mb-6 border-b border-gray-50 pb-3 uppercase tracking-wider">Top 10 Best Selling Categories</h4>
                <ul class="divide-y divide-gray-50 text-xs font-semibold text-gray-700">
                    <% if (bestSellingCategories.length === 0) { %>
                        <li class="py-4 text-center text-gray-400 font-bold uppercase">No category data</li>
                    <% } else { %>
                        <% bestSellingCategories.forEach((c, index) => { %>
                            <li class="py-3 flex justify-between items-center">
                                <span class="truncate pr-4"><%= index + 1 %>. <%= c.categoryName %></span>
                                <span class="bg-emerald-50 text-emerald-600 px-2 py-0.5 rounded text-[10px] font-bold"><%= c.quantitySold %> units</span>
                            </li>
                        <% }) %>
                    <% } %>
                </ul>
            </div>

            <!-- Brands -->
            <div class="bg-white p-8 rounded-2xl custom-shadow h-full">
                <h4 class="text-sm font-bold text-gray-800 mb-6 border-b border-gray-50 pb-3 uppercase tracking-wider">Top 10 Best Selling Brands</h4>
                <ul class="divide-y divide-gray-50 text-xs font-semibold text-gray-700">
                    <% if (bestSellingBrands.length === 0) { %>
                        <li class="py-4 text-center text-gray-400 font-bold uppercase">No brand data</li>
                    <% } else { %>
                        <% bestSellingBrands.forEach((b, index) => { %>
                            <li class="py-3 flex justify-between items-center">
                                <span class="truncate pr-4"><%= index + 1 %>. <%= b.brandName || 'Generics / Other' %></span>
                                <span class="bg-indigo-50 text-indigo-600 px-2 py-0.5 rounded text-[10px] font-bold"><%= b.quantitySold %> units</span>
                            </li>
                        <% }) %>
                    <% } %>
                </ul>
            </div>
        </section>

    </main>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const labels = <%- JSON.stringify(chartLabels || []) %>;
            const data = <%- JSON.stringify(chartData || []) %>;

            const ctx = document.getElementById('revenueLineChart').getContext('2d');
            
            // Create smooth gradient fill under the line
            const gradient = ctx.createLinearGradient(0, 0, 0, 300);
            gradient.addColorStop(0, 'rgba(59, 130, 246, 0.35)');
            gradient.addColorStop(1, 'rgba(59, 130, 246, 0.0)');

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels.length > 0 ? labels : ['No Data'],
                    datasets: [{
                        label: 'Revenue (₹)',
                        data: data.length > 0 ? data : [0],
                        borderColor: '#3b82f6',
                        backgroundColor: gradient,
                        borderWidth: 3,
                        pointBackgroundColor: '#2563eb',
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        tension: 0.4,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return 'Revenue: ₹' + Number(context.raw).toLocaleString();
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: { font: { size: 10, weight: '500' }, color: '#9ca3af' }
                        },
                        y: {
                            grid: { color: '#f3f4f6' },
                            ticks: {
                                font: { size: 10, weight: '500' },
                                color: '#9ca3af',
                                callback: function(value) {
                                    return '₹' + value.toLocaleString();
                                }
                            },
                            beginAtZero: true
                        }
                    }
                }
            });
        });
    </script>
</body>
</html>