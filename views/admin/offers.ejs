<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Offers & Discounts | ZIYAURA Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body {
            font-family: 'Inter', sans-serif;
            background-color: #F3F6F9;
        }
        .custom-shadow {
            box-shadow: 0 2px 15px rgba(0,0,0,0.03);
        }
    </style>
</head>
<body class="flex min-h-screen">

    <%- include("../partials/admin/navbar")%>

    <!-- Main Content -->
    <main class="ml-64 flex-grow p-10">
        
        <!-- Header -->
        <header class="flex justify-between items-center mb-10">
            <div>
                <h2 class="text-2xl font-bold text-gray-800">Offers Module</h2>
                <p class="text-xs text-gray-400 font-medium mt-1">Manage product, category and referral campaigns</p>
            </div>
            <button onclick="toggleForm(true)" class="bg-blue-500 hover:bg-blue-600 text-white font-bold text-xs uppercase px-4 py-2.5 rounded-lg tracking-widest transition-all">
                <i class="fa-solid fa-plus mr-1.5"></i> Add Offer
            </button>
        </header>

        <!-- Search Bar Section -->
        <section class="bg-white p-5 rounded-2xl custom-shadow mb-6">
            <form action="/admin/offers" method="GET" class="flex gap-4 items-center">
                <div class="relative flex-grow">
                    <input type="text" name="search" value="<%= typeof search !== 'undefined' ? search : '' %>" placeholder="Search offer campaign by name, target or discount type..." class="w-full pl-10 pr-4 py-2.5 border border-gray-200 rounded-xl text-xs focus:outline-none focus:border-blue-500">
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3.5 text-gray-400 text-xs"></i>
                </div>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs px-6 py-2.5 rounded-xl uppercase tracking-wider transition-colors">
                    Search
                </button>
                <% if (typeof search !== 'undefined' && search) { %>
                    <a href="/admin/offers" class="bg-gray-100 hover:bg-gray-200 text-gray-600 font-bold text-xs px-5 py-2.5 rounded-xl uppercase tracking-wider transition-colors">
                        Clear
                    </a>
                <% } %>
            </form>
        </section>

        <!-- Create/Edit Offer Form Section (Collapsible) -->
        <section id="offerForm" class="bg-white p-8 rounded-2xl custom-shadow mb-8 hidden">
            <h4 id="formTitle" class="text-sm font-bold text-gray-800 mb-6">Create New Offer Campaign</h4>
            <form id="campaignForm" novalidate onsubmit="event.preventDefault(); submitOffer();" class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <input type="hidden" id="offerId">
                
                <!-- Campaign Name -->
                <div class="space-y-1.5">
                    <label class="block text-[10px] font-bold text-gray-400 tracking-wider uppercase">Campaign Name</label>
                    <input type="text" id="name" class="form-input-field w-full border border-gray-200 text-xs px-3 py-2.5 focus:outline-none focus:border-blue-500 rounded-lg transition-colors" placeholder="e.g. Summer Sparkle Sale">
                    <p id="nameError" class="validation-error text-rose-500 text-[11px] font-medium hidden"></p>
                </div>

                <!-- Discount Type -->
                <div class="space-y-1.5">
                    <label class="block text-[10px] font-bold text-gray-400 tracking-wider uppercase">Discount Type</label>
                    <select id="discountType" class="form-input-field w-full border border-gray-200 text-xs px-3 py-2.5 focus:outline-none focus:border-blue-500 rounded-lg bg-white transition-colors">
                        <option value="percentage">Percentage (%)</option>
                        <option value="fixed">Fixed Discount (₹)</option>
                    </select>
                    <p id="discountTypeError" class="validation-error text-rose-500 text-[11px] font-medium hidden"></p>
                </div>

                <!-- Discount Value -->
                <div class="space-y-1.5">
                    <label class="block text-[10px] font-bold text-gray-400 tracking-wider uppercase">Discount Value</label>
                    <input type="text" id="discountValue" class="form-input-field w-full border border-gray-200 text-xs px-3 py-2.5 focus:outline-none focus:border-blue-500 rounded-lg transition-colors" placeholder="e.g. 15 or 500">
                    <p id="discountValueError" class="validation-error text-rose-500 text-[11px] font-medium hidden"></p>
                </div>

                <!-- Target Type -->
                <div class="space-y-1.5">
                    <label class="block text-[10px] font-bold text-gray-400 tracking-wider uppercase">Target Campaign Type</label>
                    <select id="targetType" onchange="adjustTargetSelectors()" class="form-input-field w-full border border-gray-200 text-xs px-3 py-2.5 focus:outline-none focus:border-blue-500 rounded-lg bg-white transition-colors">
                        <option value="product">Product Specific</option>
                        <option value="category">Category Specific</option>
                    </select>
                    <p id="targetTypeError" class="validation-error text-rose-500 text-[11px] font-medium hidden"></p>
                </div>

                <!-- Product dropdown selector -->
                <div id="productSelectorContainer" class="space-y-1.5">
                    <label class="block text-[10px] font-bold text-gray-400 tracking-wider uppercase">Select Product Target</label>
                    <select id="productTarget" class="form-input-field w-full border border-gray-200 text-xs px-3 py-2.5 focus:outline-none focus:border-blue-500 rounded-lg bg-white transition-colors">
                        <option value="">-- Choose Product --</option>
                        <% products.forEach(p => { %>
                            <option value="<%= p._id %>"><%= p.name %></option>
                        <% }) %>
                    </select>
                    <p id="productTargetError" class="validation-error text-rose-500 text-[11px] font-medium hidden"></p>
                </div>

                <!-- Category dropdown selector -->
                <div id="categorySelectorContainer" class="space-y-1.5 hidden">
                    <label class="block text-[10px] font-bold text-gray-400 tracking-wider uppercase">Select Category Target</label>
                    <select id="categoryTarget" class="form-input-field w-full border border-gray-200 text-xs px-3 py-2.5 focus:outline-none focus:border-blue-500 rounded-lg bg-white transition-colors">
                        <option value="">-- Choose Category --</option>
                        <% categories.forEach(c => { %>
                            <option value="<%= c._id %>"><%= c.name %></option>
                        <% }) %>
                    </select>
                    <p id="categoryTargetError" class="validation-error text-rose-500 text-[11px] font-medium hidden"></p>
                </div>

                <!-- Expiry Date -->
                <div class="space-y-1.5">
                    <label class="block text-[10px] font-bold text-gray-400 tracking-wider uppercase">Expiry Date</label>
                    <input type="date" id="expiryDate" class="form-input-field w-full border border-gray-200 text-xs px-3 py-2.5 focus:outline-none focus:border-blue-500 rounded-lg transition-colors">
                    <p id="expiryDateError" class="validation-error text-rose-500 text-[11px] font-medium hidden"></p>
                </div>

                <div class="md:col-span-3 flex justify-end gap-3 pt-4 border-t border-gray-50 text-[10px] font-bold tracking-widest uppercase">
                    <button type="button" onclick="toggleForm(true)" class="bg-gray-100 text-gray-600 px-6 py-3 rounded-lg hover:bg-gray-200 transition-colors">Cancel</button>
                    <button type="submit" id="submitBtn" class="bg-blue-500 text-white px-6 py-3 rounded-lg hover:bg-blue-600 transition-colors">Save Offer Campaign</button>
                </div>
            </form>
        </section>

        <!-- Offer Listing Table -->
        <section class="bg-white rounded-2xl custom-shadow overflow-hidden">
            <table class="w-full text-left">
                <thead>
                    <tr class="text-[11px] font-bold text-gray-400 border-b border-gray-50 uppercase tracking-wider">
                        <th class="px-8 py-5">Campaign Name</th>
                        <th class="px-6 py-5">Target Type</th>
                        <th class="px-6 py-5">Target Scope</th>
                        <th class="px-6 py-5">Discount Offer</th>
                        <th class="px-6 py-5">Expiry Date</th>
                        <th class="px-8 py-5 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50 text-xs font-semibold text-gray-700">
                    <% if (offers.length === 0) { %>
                        <tr>
                            <td colspan="6" class="text-center py-10 text-gray-400 uppercase tracking-wider">No offer campaigns created yet.</td>
                        </tr>
                    <% } else { %>
                        <% offers.forEach(o => { 
                            const isExpired = new Date() > new Date(o.expiryDate);
                        %>
                            <tr class="hover:bg-gray-50/50 transition-colors">
                                <td class="px-8 py-5 text-gray-900 font-bold"><%= o.name %></td>
                                <td class="px-6 py-5 uppercase text-[10px] font-bold"><span class="bg-blue-50 text-blue-500 px-2 py-0.5 rounded-sm"><%= o.targetType %></span></td>
                                <td class="px-6 py-5 text-gray-500 font-medium">
                                    <% if (o.targetType === 'product' && o.productTarget) { %>
                                        <%= o.productTarget.name %>
                                    <% } else if (o.targetType === 'category' && o.categoryTarget) { %>
                                        <%= o.categoryTarget.name %>
                                    <% } else { %>
                                        -
                                    <% } %>
                                </td>
                                <td class="px-6 py-5 text-emerald-600 font-extrabold">
                                    <%= o.discountType === 'percentage' ? o.discountValue + '%' : '₹' + o.discountValue %>
                                </td>
                                <td class="px-6 py-5 <%= isExpired ? 'text-rose-500 font-bold' : 'text-gray-400' %>">
                                    <%= new Date(o.expiryDate).toLocaleDateString() %>
                                    <% if (isExpired) { %> (EXPIRED) <% } %>
                                </td>
                                <td class="px-8 py-5 text-right">
                                    <button onclick='editOffer(<%- JSON.stringify(o) %>)' class="text-blue-500 hover:text-blue-700 transition-colors font-bold text-[10px] uppercase tracking-widest mr-3"><i class="fa-solid fa-pen-to-square text-sm mr-1"></i> Edit</button>
                                    <button onclick="deleteOffer('<%= o._id %>')" class="text-rose-500 hover:text-rose-700 transition-colors font-bold text-[10px] uppercase tracking-widest"><i class="fa-solid fa-trash-can text-sm mr-1"></i> Delete</button>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>

            <!-- Enhanced Pagination Bar -->
            <% if (typeof totalPages !== 'undefined') { %>
                <div class="flex flex-col sm:flex-row justify-between items-center px-8 py-5 border-t border-gray-100 gap-4 bg-gray-50/30">
                    <div class="text-xs text-gray-500 font-medium">
                        Page <span class="font-bold text-gray-800"><%= currentPage %></span> of <span class="font-bold text-gray-800"><%= totalPages %></span> 
                        <span class="text-gray-400 font-normal ml-1">(<%= totalOffers %> offers found)</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <% if (currentPage > 1) { %>
                            <a href="/admin/offers?page=<%= currentPage - 1 %>&search=<%= typeof search !== 'undefined' ? search : '' %>" class="px-3 py-1.5 rounded-lg border border-gray-200 text-xs font-bold text-gray-600 hover:bg-gray-100 transition-colors">
                                <i class="fa-solid fa-chevron-left mr-1"></i> Prev
                            </a>
                        <% } else { %>
                            <span class="px-3 py-1.5 rounded-lg border border-gray-100 text-xs font-bold text-gray-300 cursor-not-allowed">
                                <i class="fa-solid fa-chevron-left mr-1"></i> Prev
                            </span>
                        <% } %>

                        <% for(let i = 1; i <= totalPages; i++){ %>
                            <a href="/admin/offers?page=<%= i %>&search=<%= typeof search !== 'undefined' ? search : '' %>" class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition-colors <%= currentPage === i ? 'bg-black text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200' %>">
                                <%= i %>
                            </a>
                        <% } %>

                        <% if (currentPage < totalPages) { %>
                            <a href="/admin/offers?page=<%= currentPage + 1 %>&search=<%= typeof search !== 'undefined' ? search : '' %>" class="px-3 py-1.5 rounded-lg border border-gray-200 text-xs font-bold text-gray-600 hover:bg-gray-100 transition-colors">
                                Next <i class="fa-solid fa-chevron-right ml-1"></i>
                            </a>
                        <% } else { %>
                            <span class="px-3 py-1.5 rounded-lg border border-gray-100 text-xs font-bold text-gray-300 cursor-not-allowed">
                                Next <i class="fa-solid fa-chevron-right ml-1"></i>
                            </span>
                        <% } %>
                    </div>
                </div>
            <% } %>
        </section>

    </main>

    <script>
        // Clear all inline validation error messages and styling
        function clearErrors() {
            const errorElements = document.querySelectorAll('.validation-error');
            errorElements.forEach(el => {
                el.innerText = '';
                el.classList.add('hidden');
            });
            const inputElements = document.querySelectorAll('.form-input-field');
            inputElements.forEach(el => {
                el.classList.remove('border-rose-500', 'focus:border-rose-500');
                el.classList.add('border-gray-200', 'focus:border-blue-500');
            });
        }

        // Set inline error message and red border for a specific field
        function setError(fieldId, errorId, message) {
            const field = document.getElementById(fieldId);
            const errorEl = document.getElementById(errorId);
            if (field && errorEl) {
                field.classList.remove('border-gray-200', 'focus:border-blue-500');
                field.classList.add('border-rose-500', 'focus:border-rose-500');
                errorEl.innerText = message;
                errorEl.classList.remove('hidden');
            }
        }

        function toggleForm(reset = false) {
            const form = document.getElementById('offerForm');
            clearErrors();
            if (reset) {
                document.getElementById('offerId').value = '';
                document.getElementById('name').value = '';
                document.getElementById('discountType').value = 'percentage';
                document.getElementById('discountValue').value = '';
                document.getElementById('targetType').value = 'product';
                adjustTargetSelectors();
                document.getElementById('productTarget').value = '';
                document.getElementById('categoryTarget').value = '';
                document.getElementById('expiryDate').value = '';
                document.getElementById('formTitle').innerText = 'Create New Offer Campaign';
                document.getElementById('submitBtn').innerText = 'Save Offer Campaign';
            }
            form.classList.toggle('hidden');
        }

        function adjustTargetSelectors() {
            const targetType = document.getElementById('targetType').value;
            const prodCont = document.getElementById('productSelectorContainer');
            const catCont = document.getElementById('categorySelectorContainer');
            
            if (targetType === 'product') {
                prodCont.classList.remove('hidden');
                catCont.classList.add('hidden');
            } else if (targetType === 'category') {
                prodCont.classList.add('hidden');
                catCont.classList.remove('hidden');
            }
        }

        function editOffer(o) {
            clearErrors();
            document.getElementById('offerId').value = o._id;
            document.getElementById('name').value = o.name || '';
            document.getElementById('discountType').value = o.discountType || 'percentage';
            document.getElementById('discountValue').value = o.discountValue || '';
            document.getElementById('targetType').value = o.targetType || 'product';
            adjustTargetSelectors();

            if (o.targetType === 'product') {
                const prodId = (o.productTarget && o.productTarget._id) ? o.productTarget._id : o.productTarget;
                document.getElementById('productTarget').value = prodId || '';
            } else if (o.targetType === 'category') {
                const catId = (o.categoryTarget && o.categoryTarget._id) ? o.categoryTarget._id : o.categoryTarget;
                document.getElementById('categoryTarget').value = catId || '';
            }

            if (o.expiryDate) {
                document.getElementById('expiryDate').value = new Date(o.expiryDate).toISOString().split('T')[0];
            } else {
                document.getElementById('expiryDate').value = '';
            }

            document.getElementById('formTitle').innerText = 'Edit Offer Campaign';
            document.getElementById('submitBtn').innerText = 'Update Offer Campaign';

            const form = document.getElementById('offerForm');
            form.classList.remove('hidden');
            form.scrollIntoView({ behavior: 'smooth' });
        }

        // Comprehensive Pure JavaScript Validation
        function validateOfferForm({ name, discountType, discountValue, targetType, productTarget, categoryTarget, expiryDate }) {
            clearErrors();
            let isValid = true;
            let firstInvalidFieldId = null;

            // 1. Campaign Name Validation
            if (!name) {
                setError('name', 'nameError', 'Campaign name is required.');
                isValid = false;
                if (!firstInvalidFieldId) firstInvalidFieldId = 'name';
            } else if (name.length < 3) {
                setError('name', 'nameError', 'Campaign name must be at least 3 characters.');
                isValid = false;
                if (!firstInvalidFieldId) firstInvalidFieldId = 'name';
            } else if (name.length > 50) {
                setError('name', 'nameError', 'Campaign name cannot exceed 50 characters.');
                isValid = false;
                if (!firstInvalidFieldId) firstInvalidFieldId = 'name';
            }

            // 2. Discount Type Validation
            if (!['percentage', 'fixed'].includes(discountType)) {
                setError('discountType', 'discountTypeError', 'Please select a valid discount type.');
                isValid = false;
                if (!firstInvalidFieldId) firstInvalidFieldId = 'discountType';
            }

            // 3. Discount Value Validation
            if (!discountValue && discountValue !== 0) {
                setError('discountValue', 'discountValueError', 'Discount value is required.');
                isValid = false;
                if (!firstInvalidFieldId) firstInvalidFieldId = 'discountValue';
            } else {
                const numVal = parseFloat(discountValue);
                if (isNaN(numVal) || numVal <= 0) {
                    setError('discountValue', 'discountValueError', 'Discount value must be a positive number greater than 0.');
                    isValid = false;
                    if (!firstInvalidFieldId) firstInvalidFieldId = 'discountValue';
                } else if (discountType === 'percentage' && numVal > 100) {
                    setError('discountValue', 'discountValueError', 'Percentage discount cannot exceed 100%.');
                    isValid = false;
                    if (!firstInvalidFieldId) firstInvalidFieldId = 'discountValue';
                }
            }

            // 4. Target Selection Validation
            if (!['product', 'category'].includes(targetType)) {
                setError('targetType', 'targetTypeError', 'Please select a valid target campaign type.');
                isValid = false;
                if (!firstInvalidFieldId) firstInvalidFieldId = 'targetType';
            } else if (targetType === 'product') {
                if (!productTarget) {
                    setError('productTarget', 'productTargetError', 'Please choose a target product.');
                    isValid = false;
                    if (!firstInvalidFieldId) firstInvalidFieldId = 'productTarget';
                }
            } else if (targetType === 'category') {
                if (!categoryTarget) {
                    setError('categoryTarget', 'categoryTargetError', 'Please choose a target category.');
                    isValid = false;
                    if (!firstInvalidFieldId) firstInvalidFieldId = 'categoryTarget';
                }
            }

            // 5. Expiry Date Validation
            if (!expiryDate) {
                setError('expiryDate', 'expiryDateError', 'Expiry date is required.');
                isValid = false;
                if (!firstInvalidFieldId) firstInvalidFieldId = 'expiryDate';
            } else {
                const selectedExpDate = new Date(expiryDate);
                const todayZero = new Date();
                todayZero.setHours(0, 0, 0, 0);

                if (isNaN(selectedExpDate.getTime())) {
                    setError('expiryDate', 'expiryDateError', 'Please select a valid date.');
                    isValid = false;
                    if (!firstInvalidFieldId) firstInvalidFieldId = 'expiryDate';
                } else if (selectedExpDate < todayZero) {
                    setError('expiryDate', 'expiryDateError', 'Offer campaign expiry date cannot be in the past.');
                    isValid = false;
                    if (!firstInvalidFieldId) firstInvalidFieldId = 'expiryDate';
                }
            }

            return { isValid, firstInvalidFieldId };
        }

        function submitOffer() {
            const offerId = document.getElementById('offerId').value;
            const name = document.getElementById('name').value.trim();
            const discountType = document.getElementById('discountType').value;
            const discountValue = document.getElementById('discountValue').value.trim();
            const targetType = document.getElementById('targetType').value;
            const productTarget = document.getElementById('productTarget').value;
            const categoryTarget = document.getElementById('categoryTarget').value;
            const expiryDate = document.getElementById('expiryDate').value;

            // Run Pure JavaScript Validation
            const validation = validateOfferForm({
                name,
                discountType,
                discountValue,
                targetType,
                productTarget,
                categoryTarget,
                expiryDate
            });

            if (!validation.isValid) {
                if (validation.firstInvalidFieldId) {
                    document.getElementById(validation.firstInvalidFieldId)?.focus();
                }
                return Swal.fire({
                    title: 'Validation Error',
                    text: 'Please review and resolve the highlighted errors on the form.',
                    icon: 'warning',
                    confirmButtonColor: '#3b82f6'
                });
            }

            const endpoint = offerId ? '/admin/offers/update' : '/admin/offers/create';
            const payload = {
                offerId,
                name,
                discountType,
                discountValue: parseFloat(discountValue),
                targetType,
                productTarget: targetType === 'product' ? productTarget : null,
                categoryTarget: targetType === 'category' ? categoryTarget : null,
                expiryDate
            };

            const submitBtn = document.getElementById('submitBtn');
            const originalBtnText = submitBtn.innerText;
            submitBtn.disabled = true;
            submitBtn.innerText = 'Processing...';

            fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(res => res.json())
            .then(data => {
                submitBtn.disabled = false;
                submitBtn.innerText = originalBtnText;

                if (data.success) {
                    Swal.fire({
                        title: 'Success!',
                        text: data.message,
                        icon: 'success',
                        confirmButtonText: 'OK',
                        confirmButtonColor: '#3b82f6'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.reload();
                        }
                    });
                } else {
                    Swal.fire({
                        title: 'Error!',
                        text: data.message,
                        icon: 'error',
                        confirmButtonText: 'OK',
                        confirmButtonColor: '#ef4444'
                    });
                }
            })
            .catch(err => {
                console.error(err);
                submitBtn.disabled = false;
                submitBtn.innerText = originalBtnText;

                Swal.fire({
                    title: 'Error!',
                    text: 'Something went wrong while saving the campaign.',
                    icon: 'error',
                    confirmButtonText: 'OK',
                    confirmButtonColor: '#ef4444'
                });
            });
        }

        function deleteOffer(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3b82f6',
                cancelButtonColor: '#ef4444',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch(`/admin/offers/delete/${id}`, { method: 'DELETE' })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire({
                                title: 'Deleted!',
                                text: data.message,
                                icon: 'success',
                                confirmButtonText: 'OK',
                                confirmButtonColor: '#3b82f6'
                            }).then(() => {
                                window.location.reload();
                            });
                        } else {
                            Swal.fire({
                                title: 'Error!',
                                text: data.message,
                                icon: 'error',
                                confirmButtonText: 'OK',
                                confirmButtonColor: '#ef4444'
                            });
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        Swal.fire({
                            title: 'Error!',
                            text: 'Failed to delete campaign.',
                            icon: 'error',
                            confirmButtonText: 'OK',
                            confirmButtonColor: '#ef4444'
                        });
                    });
                }
            });
        }

        // Live error clearing as user interacts with fields
        document.addEventListener('DOMContentLoaded', () => {
            const formFields = [
                { id: 'name', errorId: 'nameError' },
                { id: 'discountType', errorId: 'discountTypeError' },
                { id: 'discountValue', errorId: 'discountValueError' },
                { id: 'targetType', errorId: 'targetTypeError' },
                { id: 'productTarget', errorId: 'productTargetError' },
                { id: 'categoryTarget', errorId: 'categoryTargetError' },
                { id: 'expiryDate', errorId: 'expiryDateError' }
            ];

            formFields.forEach(({ id, errorId }) => {
                const field = document.getElementById(id);
                const errorEl = document.getElementById(errorId);
                if (field && errorEl) {
                    const eventName = field.tagName.toLowerCase() === 'select' || field.type === 'date' ? 'change' : 'input';
                    field.addEventListener(eventName, () => {
                        field.classList.remove('border-rose-500', 'focus:border-rose-500');
                        field.classList.add('border-gray-200', 'focus:border-blue-500');
                        errorEl.innerText = '';
                        errorEl.classList.add('hidden');
                    });
                }
            });
        });
    </script>
</body>
</html>
