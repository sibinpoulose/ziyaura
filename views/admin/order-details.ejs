<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Order Details | ZIYAURA Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');
    body {
      font-family: 'Inter', sans-serif;
      background-color: #F3F6F9;
    }
    .custom-shadow {
      box-shadow: 0 2px 15px rgba(0,0,0,0.02);
    }
  </style>
</head>
<body class="flex min-h-screen">

  <%- include("../partials/admin/navbar") %>

  <!-- Main Content -->
  <main class="ml-64 flex-grow p-10">
    
    <!-- Top Nav / Back Button -->
    <div class="flex items-center justify-between mb-8">
      <a href="/admin/orders" class="text-xs font-bold tracking-widest uppercase text-gray-500 hover:text-black flex items-center gap-1.5 transition-colors">
        <i class="fa-solid fa-arrow-left text-[10px]"></i> Back to Orders
      </a>
      
      <div class="flex items-center gap-2">
        <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mr-2">Admin Actions</span>
        <% if (order.orderStatus !== 'Cancelled' && order.orderStatus !== 'Delivered') { %>
          <div class="relative inline-block w-48">
            <select
              id="detailStatusSelect"
              onchange="updateDetailStatus('<%= order._id %>')"
              class="appearance-none w-full bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold tracking-wider uppercase px-4 py-2.5 pr-8 rounded-lg focus:outline-none cursor-pointer shadow-sm transition-all"
            >
              <option value="Pending" <%= order.orderStatus === 'Pending' ? 'selected' : '' %>>Pending</option>
              <option value="Shipped" <%= order.orderStatus === 'Shipped' ? 'selected' : '' %>>Shipped</option>
              <option value="Out for Delivery" <%= order.orderStatus === 'Out for Delivery' ? 'selected' : '' %>>Out for Delivery</option>
              <option value="Delivered" <%= order.orderStatus === 'Delivered' ? 'selected' : '' %>>Delivered</option>
              <option value="Cancelled" <%= order.orderStatus === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
            </select>
            <span class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-white text-xs">
              <i class="fa-solid fa-caret-down"></i>
            </span>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Order Header Summary -->
    <section class="bg-white rounded-2xl p-8 mb-8 custom-shadow border border-gray-100/50">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 pb-6 border-b border-gray-100">
        <div>
          <span class="text-[10px] font-bold tracking-widest text-gray-400 uppercase">Order Summary</span>
          <h1 class="text-2xl font-extrabold text-gray-900 tracking-tight mt-1">ID: <%= order.orderId %></h1>
          <p class="text-xs text-gray-400 mt-1">Placed on <%= new Date(order.createdAt).toLocaleString(undefined, { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></p>
        </div>
        
        <div class="flex flex-col items-start md:items-end gap-1.5">
          <span class="text-[10px] font-bold tracking-widest text-gray-400 uppercase">Shipping Status</span>
          <% if (order.orderStatus === 'Cancelled') { %>
            <span class="text-[10px] font-bold tracking-widest text-rose-600 bg-rose-50 border border-rose-100 px-4 py-1.5 rounded-full uppercase"><%= order.orderStatus %></span>
          <% } else if (order.orderStatus === 'Delivered') { %>
            <span class="text-[10px] font-bold tracking-widest text-emerald-600 bg-emerald-50 border border-emerald-100 px-4 py-1.5 rounded-full uppercase"><%= order.orderStatus %></span>
          <% } else { %>
            <span class="text-[10px] font-bold tracking-widest text-amber-600 bg-amber-50 border border-amber-100 px-4 py-1.5 rounded-full uppercase"><%= order.orderStatus %></span>
          <% } %>
        </div>
      </div>

      <!-- Stepper timeline for Order Status (Only if not Cancelled) -->
      <% if (order.orderStatus !== 'Cancelled') { %>
        <div class="py-8 border-b border-gray-50">
          <div class="relative flex justify-between items-center max-w-2xl mx-auto">
            <!-- Progress Bar Line -->
            <% 
              let percent = '0%';
              if (order.orderStatus === 'Shipped') percent = '33%';
              else if (order.orderStatus === 'Out for Delivery') percent = '66%';
              else if (order.orderStatus === 'Delivered') percent = '100%';
            %>
            <div class="absolute left-0 top-1/2 -translate-y-1/2 h-1 bg-gray-100 w-full rounded-full z-0">
              <div class="h-full bg-blue-600 transition-all duration-500 rounded-full" style="width: <%= percent %>"></div>
            </div>
            
            <!-- Step Items -->
            <% const steps = ['Pending', 'Shipped', 'Out for Delivery', 'Delivered']; %>
            <% steps.forEach((step, idx) => { %>
              <% 
                let isActive = false;
                let isCompleted = false;
                const orderStatusIdx = steps.indexOf(order.orderStatus);
                
                if (orderStatusIdx >= idx) isActive = true;
                if (orderStatusIdx > idx) isCompleted = true;
              %>
              <div class="relative z-10 flex flex-col items-center">
                <div class="w-10 h-10 rounded-full border-2 flex items-center justify-center text-xs font-bold transition-all duration-300
                  <%= isCompleted ? 'bg-blue-600 border-blue-600 text-white' : (isActive ? 'bg-white border-blue-600 text-blue-600' : 'bg-white border-gray-200 text-gray-400') %>
                ">
                  <% if (isCompleted) { %>
                    <i class="fa-solid fa-check text-xs"></i>
                  <% } else { %>
                    <%= idx + 1 %>
                  <% } %>
                </div>
                <span class="text-[9px] font-bold uppercase tracking-widest mt-2 bg-white px-2 py-0.5 rounded-md
                  <%= isActive ? 'text-gray-900 font-extrabold' : 'text-gray-400' %>
                "><%= step %></span>
              </div>
            <% }); %>
          </div>
        </div>
      <% } %>

      <!-- Customer Details, Address, Billing grid -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 pt-8">
        
        <!-- Customer Info -->
        <div class="space-y-4">
          <h3 class="text-xs font-bold tracking-widest text-gray-400 uppercase">Customer Details</h3>
          <div class="border border-gray-100 rounded-2xl p-5 bg-gray-50/50 space-y-3">
            <div>
              <p class="text-[10px] text-gray-400 font-bold uppercase">Name</p>
              <p class="text-sm font-bold text-gray-800"><%= order.userId ? order.userId.name : 'Unknown User' %></p>
            </div>
            <div>
              <p class="text-[10px] text-gray-400 font-bold uppercase">Email</p>
              <p class="text-sm font-semibold text-gray-800"><%= order.userId ? order.userId.email : 'N/A' %></p>
            </div>
            <div>
              <p class="text-[10px] text-gray-400 font-bold uppercase">Phone</p>
              <p class="text-sm font-semibold text-gray-800"><%= order.userId ? order.userId.phone : 'N/A' %></p>
            </div>
          </div>
        </div>

        <!-- Shipping Address -->
        <div class="space-y-4">
          <h3 class="text-xs font-bold tracking-widest text-gray-400 uppercase">Shipping Address</h3>
          <div class="border border-gray-100 rounded-2xl p-5 bg-gray-50/50 text-xs text-gray-700 leading-relaxed space-y-1">
            <p class="font-extrabold text-gray-900 text-sm mb-1.5"><%= order.shippingAddress.fullName %></p>
            <p><%= order.shippingAddress.address %></p>
            <% if (order.shippingAddress.landmark) { %>
              <p class="italic text-gray-500">Landmark: <%= order.shippingAddress.landmark %></p>
            <% } %>
            <p><%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> - <span class="font-bold text-gray-900"><%= order.shippingAddress.pincode %></span></p>
            <p class="pt-2 font-bold text-gray-900">Phone: +91 <%= order.shippingAddress.phone %></p>
            <span class="inline-block text-[8px] font-bold tracking-widest text-gray-500 bg-gray-150 border px-2 py-0.5 mt-2 rounded uppercase"><%= order.shippingAddress.addressType %></span>
          </div>
        </div>

        <!-- Payment Info -->
        <div class="space-y-4">
          <h3 class="text-xs font-bold tracking-widest text-gray-400 uppercase">Payment Summary</h3>
          <div class="border border-gray-100 rounded-2xl p-5 bg-gray-50/50 space-y-4 text-xs font-semibold">
            <div class="grid grid-cols-2 gap-y-2">
              <div class="text-gray-400">Method</div>
              <div class="text-right text-gray-900 font-bold uppercase"><%= order.paymentMethod %></div>
              
              <div class="text-gray-400">Payment Status</div>
              <div class="text-right">
                <% if (order.paymentStatus === 'Paid') { %>
                  <span class="text-emerald-600 font-extrabold uppercase">PAID</span>
                <% } else if (order.paymentStatus === 'Failed') { %>
                  <span class="text-rose-600 font-extrabold uppercase">FAILED</span>
                <% } else { %>
                  <span class="text-amber-600 font-extrabold uppercase">PENDING</span>
                <% } %>
              </div>
            </div>
            
            <hr class="border-gray-100">

            <div class="space-y-2">
              <div class="flex justify-between">
                <span class="text-gray-400">Subtotal</span>
                <span class="text-gray-900">₹<%= order.subtotal.toLocaleString() %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-400">Shipping</span>
                <span class="text-gray-900"><%= order.shippingCharge === 0 ? 'FREE' : '₹' + order.shippingCharge.toLocaleString() %></span>
              </div>
              <% if (order.discount > 0) { %>
                <div class="flex justify-between text-rose-500">
                  <span>Discount</span>
                  <span>- ₹<%= order.discount.toLocaleString() %></span>
                </div>
              <% } %>
              <hr class="border-gray-100 my-1">
              <div class="flex justify-between text-sm">
                <span class="font-extrabold text-gray-900 uppercase">Grand Total</span>
                <span class="font-black text-black">₹<%= order.grandTotal.toLocaleString() %></span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- Products Ordered Card -->
    <section class="bg-white rounded-2xl p-8 custom-shadow border border-gray-100/50">
      <h3 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-6">Ordered Items (<%= order.products.length %>)</h3>
      
      <div class="divide-y divide-gray-150">
        <% order.products.forEach(item => { %>
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 py-6 first:pt-0 last:pb-0">
            <!-- Product Information -->
            <div class="flex items-center gap-4">
              <div class="w-16 h-16 bg-gray-50 border border-gray-150 rounded-lg overflow-hidden flex-shrink-0 flex items-center justify-center">
                <% if (item.image) { %>
                  <img src="<%= item.image %>" alt="<%= item.name %>" class="w-full h-full object-cover">
                <% } else { %>
                  <i class="fa-regular fa-image text-gray-300 text-lg"></i>
                <% } %>
              </div>
              
              <div class="space-y-1">
                <h4 class="text-sm font-bold text-gray-900 leading-snug"><%= item.name %></h4>
                <% if (item.variantDetails) { %>
                  <span class="block text-[8px] font-bold text-gray-400 uppercase tracking-widest"><%= item.variantDetails %></span>
                <% } %>
                <p class="text-[10px] text-gray-500 font-semibold mt-0.5">Price: ₹<%= item.price.toLocaleString() %> &bull; Qty: <%= item.quantity %></p>
                <% if (item.sku) { %>
                  <code class="block text-[9px] font-mono text-gray-400">SKU: <%= item.sku %></code>
                <% } %>
              </div>
            </div>

            <!-- Total price & Status -->
            <div class="flex flex-col items-start md:items-end gap-2">
              <div>
                <span class="text-xs font-bold text-gray-400 uppercase">Item Total: </span>
                <span class="text-sm font-extrabold text-gray-900">₹<%= item.total.toLocaleString() %></span>
              </div>
              <div>
                <% if (item.orderStatus === 'Cancelled') { %>
                  <span class="text-[8px] font-bold tracking-widest text-rose-600 bg-rose-50 border border-rose-100 px-2 py-0.5 rounded uppercase">Cancelled</span>
                  <% if (item.cancelReason) { %>
                    <span class="block text-[9px] text-rose-400 italic mt-1">Reason: <%= item.cancelReason %></span>
                  <% } %>
                <% } else if (item.orderStatus === 'Returned') { %>
                  <span class="text-[8px] font-bold tracking-widest text-purple-600 bg-purple-50 border border-purple-100 px-2 py-0.5 rounded uppercase">Returned</span>
                  <% if (item.returnReason) { %>
                    <span class="block text-[9px] text-purple-400 italic mt-1">Reason: <%= item.returnReason %></span>
                  <% } %>
                <% } else if (item.orderStatus === 'Delivered') { %>
                  <span class="text-[8px] font-bold tracking-widest text-emerald-600 bg-emerald-50 border border-emerald-100 px-2 py-0.5 rounded uppercase">Delivered</span>
                <% } else { %>
                  <span class="text-[8px] font-bold tracking-widest text-amber-600 bg-amber-50 border border-amber-100 px-2 py-0.5 rounded uppercase"><%= item.orderStatus %></span>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </section>

  </main>

  <%- include("../partials/toast") %>

  <!-- Status change AJAX script -->
  <script>
    async function updateDetailStatus(orderId) {
      const selectElem = document.getElementById('detailStatusSelect');
      const originalValue = selectElem.getAttribute('data-original') || selectElem.value;
      const newStatus = selectElem.value;

      if (newStatus === 'Cancelled') {
        if (!confirm('Are you sure you want to Cancel this entire order? This will restore stock levels and cannot be undone.')) {
          selectElem.value = originalValue;
          return;
        }
      } else if (newStatus === 'Delivered') {
        if (!confirm('Mark this order as Delivered? This will mark COD payment as Paid and cannot be undone.')) {
          selectElem.value = originalValue;
          return;
        }
      }

      try {
        const response = await fetch(`/admin/orders/${orderId}/status`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ orderStatus: newStatus })
        });
        const data = await response.json();

        if (data.success) {
          showToast(data.message, 'success');
          selectElem.setAttribute('data-original', newStatus);
          setTimeout(() => window.location.reload(), 1200);
        } else {
          showToast(data.message || 'Failed to update order status', 'error');
          selectElem.value = originalValue;
        }
      } catch (err) {
        console.error(err);
        showToast('Network error, please try again.', 'error');
        selectElem.value = originalValue;
      }
    }

    // Set initial custom attribute
    const statusSelect = document.getElementById('detailStatusSelect');
    if (statusSelect) {
      statusSelect.setAttribute('data-original', statusSelect.value);
    }
  </script>

</body>
</html>
