<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sales Report | ZIYAURA Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body {
            font-family: 'Inter', sans-serif;
            background-color: #F3F6F9;
        }
        .custom-shadow {
            box-shadow: 0 2px 15px rgba(0,0,0,0.03);
        }
    </style>
</head>
<body class="flex min-h-screen">

    <%- include("../partials/admin/navbar")%>

    <!-- Main Content -->
    <main class="ml-64 flex-grow p-10 overflow-x-auto">
        
        <!-- Header -->
        <header class="flex justify-between items-center mb-8">
            <div>
                <h2 class="text-2xl font-bold text-gray-800">Sales Ledger Book Report</h2>
                <p class="text-xs text-gray-400 font-medium mt-1">Review checkout collections, coupon deductions, and download metrics statement sheets</p>
            </div>

            <!-- Action Downloads Bar -->
            <div class="flex gap-3">
                <a href="/admin/sales-report/excel?startDate=<%= startDate %>&endDate=<%= endDate %>" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-[10px] tracking-widest uppercase px-4 py-2.5 rounded-lg transition-colors flex items-center gap-2 shadow-sm">
                    <i class="fa-regular fa-file-excel text-sm"></i> Excel Report
                </a>
                <a href="/admin/sales-report/pdf?startDate=<%= startDate %>&endDate=<%= endDate %>" class="bg-rose-600 hover:bg-rose-700 text-white font-bold text-[10px] tracking-widest uppercase px-4 py-2.5 rounded-lg transition-colors flex items-center gap-2 shadow-sm">
                    <i class="fa-regular fa-file-pdf text-sm"></i> PDF Report
                </a>
            </div>
        </header>

        <!-- Filters Form -->
        <section class="bg-white p-8 rounded-2xl custom-shadow mb-8">
            <form id="reportFilterForm" action="/admin/sales-report" method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 items-end">
                <div class="space-y-2">
                    <label class="block text-[10px] font-bold text-gray-400 tracking-wider uppercase">Filter Presets</label>
                    <select name="filterType" onchange="this.form.submit()" class="w-full border border-gray-200 text-xs px-3 py-2.5 focus:outline-none focus:border-blue-500 rounded-lg bg-white">
                        <option value="" <%= !filterType ? 'selected' : '' %>>Custom Date Range</option>
                        <option value="daily" <%= filterType === 'daily' ? 'selected' : '' %>>Daily (Today)</option>
                        <option value="weekly" <%= filterType === 'weekly' ? 'selected' : '' %>>Weekly (Last 7 Days)</option>
                        <option value="yearly" <%= filterType === 'yearly' ? 'selected' : '' %>>Yearly (Current Year)</option>
                    </select>
                </div>
                <div class="space-y-2">
                    <label class="block text-[10px] font-bold text-gray-400 tracking-wider uppercase">Start Date</label>
                    <input type="date" id="startDateInput" name="startDate" value="<%= startDate %>" class="w-full border border-gray-200 text-xs px-3 py-2 focus:outline-none focus:border-blue-500 rounded-lg">
                </div>
                <div class="space-y-2">
                    <label class="block text-[10px] font-bold text-gray-400 tracking-wider uppercase">End Date</label>
                    <input type="date" id="endDateInput" name="endDate" value="<%= endDate %>" class="w-full border border-gray-200 text-xs px-3 py-2 focus:outline-none focus:border-blue-500 rounded-lg">
                </div>
                <div class="flex gap-2">
                    <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white text-[10px] font-bold tracking-widest uppercase px-5 py-3 rounded-lg transition-colors w-full">
                        Filter
                    </button>
                    <a href="/admin/sales-report" class="bg-gray-100 hover:bg-gray-200 text-gray-600 text-[10px] font-bold tracking-widest uppercase px-5 py-3 rounded-lg transition-colors w-full text-center">
                        Reset
                    </a>
                </div>
            </form>
        </section>

        <!-- KPI summary statistics cards -->
        <section class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8 text-white font-bold">
            <div class="p-6 bg-gradient-to-r from-blue-500 to-indigo-500 rounded-2xl shadow-sm">
                <span class="text-[9px] uppercase tracking-wider text-blue-100 font-bold block mb-1">Total Sales Count</span>
                <h3 class="text-3xl"><%= overallSalesCount %></h3>
            </div>
            <div class="p-6 bg-gradient-to-r from-emerald-500 to-teal-500 rounded-2xl shadow-sm">
                <span class="text-[9px] uppercase tracking-wider text-emerald-100 font-bold block mb-1">Net Sales Revenue</span>
                <h3 class="text-3xl">₹<%= overallOrderAmount.toLocaleString() %></h3>
            </div>
            <div class="p-6 bg-gradient-to-r from-rose-500 to-pink-500 rounded-2xl shadow-sm">
                <span class="text-[9px] uppercase tracking-wider text-rose-100 font-bold block mb-1">Total Discounts Given</span>
                <h3 class="text-3xl">₹<%= overallDiscount.toLocaleString() %></h3>
            </div>
        </section>

        <!-- Reports Ledger Sheet Table -->
        <section class="bg-white rounded-2xl custom-shadow overflow-hidden">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="text-[11px] font-bold text-gray-400 border-b border-gray-100 uppercase tracking-wider bg-gray-50/50">
                        <th class="px-6 py-4">Order ID</th>
                        <th class="px-6 py-4">Date</th>
                        <th class="px-6 py-4">Customer</th>
                        <th class="px-6 py-4 text-right">Subtotal</th>
                        <th class="px-6 py-4 text-right">Discounts</th>
                        <th class="px-6 py-4 text-right">Net Sales Amount</th>
                        <th class="px-6 py-4 text-center">Payment</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50 text-xs font-semibold text-gray-700">
                    <% if(orders.length === 0) { %>
                        <tr>
                            <td colspan="7" class="text-center py-10 text-gray-400 font-bold uppercase tracking-wider">No matching transactions found.</td>
                        </tr>
                    <% } else { %>
                        <% orders.forEach(o => { %>
                            <tr class="hover:bg-gray-50/50 transition-colors">
                                <td class="px-6 py-4 text-blue-600 font-mono font-bold whitespace-nowrap"><%= o.orderId %></td>
                                <td class="px-6 py-4 text-gray-400 whitespace-nowrap"><%= o.createdAt.toLocaleDateString() %></td>
                                <td class="px-6 py-4 text-gray-800 whitespace-nowrap"><%= o.shippingAddress.fullName %></td>
                                <td class="px-6 py-4 text-right text-gray-900 whitespace-nowrap">₹<%= o.subtotal.toLocaleString() %></td>
                                <td class="px-6 py-4 text-right text-rose-500 whitespace-nowrap">-₹<%= o.discount.toLocaleString() %></td>
                                <td class="px-6 py-4 text-right text-emerald-600 font-extrabold whitespace-nowrap">₹<%= o.grandTotal.toLocaleString() %></td>
                                <td class="px-6 py-4 text-center whitespace-nowrap">
                                    <span class="bg-gray-100 text-gray-600 px-3 py-1 rounded-full text-[9px] uppercase tracking-widest font-bold"><%= o.paymentMethod %></span>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>

            <!-- Pagination -->
            <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                <div class="flex justify-center items-center gap-3 py-6 border-t border-gray-50">
                    <% for(let i = 1; i <= totalPages; i++){ %>
                        <a
                            href="/admin/sales-report?page=<%= i %>&startDate=<%= startDate %>&endDate=<%= endDate %>&filterType=<%= filterType %>"
                            class="px-4 py-2 rounded-lg <%= currentPage === i ? 'bg-black text-white' : 'bg-gray-200 text-gray-700' %>"
                        >
                            <%= i %>
                        </a>
                    <% } %>
                </div>
            <% } %>
        </section>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const todayStr = new Date().toISOString().split('T')[0];
            const startInput = document.getElementById('startDateInput');
            const endInput = document.getElementById('endDateInput');
            const form = document.getElementById('reportFilterForm');

            if (startInput) startInput.setAttribute('max', todayStr);
            if (endInput) endInput.setAttribute('max', todayStr);

            if (startInput && endInput) {
                startInput.addEventListener('change', () => {
                    if (startInput.value) {
                        endInput.setAttribute('min', startInput.value);
                    }
                });

                if (startInput.value) {
                    endInput.setAttribute('min', startInput.value);
                }
            }

            if (form) {
                form.addEventListener('submit', (e) => {
                    if (startInput && endInput && startInput.value && endInput.value) {
                        if (new Date(startInput.value) > new Date(endInput.value)) {
                            e.preventDefault();
                            Swal.fire({
                                title: 'Date Range Error',
                                text: 'Start date cannot be after End date.',
                                icon: 'warning',
                                confirmButtonText: 'OK'
                            });
                        }
                    }
                });
            }
        });
    </script>
</body>
</html>
