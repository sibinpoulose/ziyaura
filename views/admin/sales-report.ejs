<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sales Report | ZIYAURA Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body {
            font-family: 'Inter', sans-serif;
            background-color: #F3F6F9;
        }
        .custom-shadow {
            box-shadow: 0 2px 15px rgba(0,0,0,0.03);
        }
    </style>
</head>
<body class="flex min-h-screen">

    <%- include("../partials/admin/navbar")%>

    <!-- Main Content -->
    <main class="ml-64 flex-grow p-10">
        
        <!-- Header -->
        <header class="flex justify-between items-center mb-10">
            <div>
                <h2 class="text-2xl font-bold text-gray-800">Sales Ledger Book Report</h2>
                <p class="text-xs text-gray-400 font-medium mt-1">Review checkout collections, coupon deductions, and download metrics statement sheets</p>
            </div>
        </header>

        <!-- Filters Form -->
        <section class="bg-white p-8 rounded-2xl custom-shadow mb-8">
            <form action="/admin/sales-report" method="GET" class="grid grid-cols-1 md:grid-cols-4 gap-6 items-end">
                <div class="space-y-2">
                    <label class="block text-[10px] font-bold text-gray-400 tracking-wider uppercase">Quick Presets</label>
                    <select name="filterType" onchange="this.form.submit()" class="w-full border border-gray-200 text-xs px-3 py-2.5 focus:outline-none focus:border-blue-500 rounded-lg bg-white">
                        <option value="" <%= !filterType ? 'selected' : '' %>>Custom Date Range</option>
                        <option value="daily" <%= filterType === 'daily' ? 'selected' : '' %>>Daily (Today)</option>
                        <option value="weekly" <%= filterType === 'weekly' ? 'selected' : '' %>>Weekly (Last 7 Days)</option>
                        <option value="yearly" <%= filterType === 'yearly' ? 'selected' : '' %>>Yearly (Current Year)</option>
                    </select>
                </div>
                <div class="space-y-2">
                    <label class="block text-[10px] font-bold text-gray-400 tracking-wider uppercase">Start Date</label>
                    <input type="date" name="startDate" value="<%= startDate %>" class="w-full border border-gray-200 text-xs px-3 py-2 focus:outline-none focus:border-blue-500 rounded-lg">
                </div>
                <div class="space-y-2">
                    <label class="block text-[10px] font-bold text-gray-400 tracking-wider uppercase">End Date</label>
                    <input type="date" name="endDate" value="<%= endDate %>" class="w-full border border-gray-200 text-xs px-3 py-2 focus:outline-none focus:border-blue-500 rounded-lg">
                </div>
                <div class="flex gap-2">
                    <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white text-[10px] font-bold tracking-widest uppercase px-5 py-3 rounded-lg flex-fill transition-colors w-full">
                        Filter
                    </button>
                    <a href="/admin/sales-report" class="bg-gray-100 hover:bg-gray-200 text-gray-600 text-[10px] font-bold tracking-widest uppercase px-5 py-3 rounded-lg flex-fill transition-colors w-full text-center">
                        Reset
                    </a>
                </div>
            </form>
        </section>

        <!-- KPI summary statistics cards -->
        <section class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8 text-white font-bold">
            <div class="p-6 bg-gradient-to-r from-blue-500 to-indigo-500 rounded-2xl shadow-sm">
                <span class="text-[9px] uppercase tracking-wider text-blue-100 font-bold block mb-1">Total Sales Count</span>
                <h3 class="text-3xl"><%= overallSalesCount %></h3>
            </div>
            <div class="p-6 bg-gradient-to-r from-emerald-500 to-teal-500 rounded-2xl shadow-sm">
                <span class="text-[9px] uppercase tracking-wider text-emerald-100 font-bold block mb-1">Net sales Revenue</span>
                <h3 class="text-3xl">₹<%= overallOrderAmount.toLocaleString() %></h3>
            </div>
            <div class="p-6 bg-gradient-to-r from-rose-500 to-pink-500 rounded-2xl shadow-sm">
                <span class="text-[9px] uppercase tracking-wider text-rose-100 font-bold block mb-1">Total Discounts Given</span>
                <h3 class="text-3xl">₹<%= overallDiscount.toLocaleString() %></h3>
            </div>
        </section>

        <!-- Action Downloads Bar -->
        <section class="flex justify-end gap-3 mb-6">
            <a href="/admin/sales-report/excel?startDate=<%= startDate %>&endDate=<%= endDate %>" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-[10px] tracking-widest uppercase px-4 py-2.5 rounded-lg transition-colors flex items-center gap-2">
                <i class="fa-regular fa-file-excel text-sm"></i> Download Excel
            </a>
            <a href="/admin/sales-report/pdf?startDate=<%= startDate %>&endDate=<%= endDate %>" class="bg-rose-600 hover:bg-rose-700 text-white font-bold text-[10px] tracking-widest uppercase px-4 py-2.5 rounded-lg transition-colors flex items-center gap-2">
                <i class="fa-regular fa-file-pdf text-sm"></i> Download PDF
            </a>
        </section>

        <!-- Reports Ledger Sheet Table -->
        <section class="bg-white rounded-2xl custom-shadow overflow-hidden">
            <table class="w-full text-left">
                <thead>
                    <tr class="text-[11px] font-bold text-gray-400 border-b border-gray-50 uppercase tracking-wider">
                        <th class="px-8 py-5">Order ID</th>
                        <th class="px-6 py-5">Date</th>
                        <th class="px-6 py-5">Customer</th>
                        <th class="px-6 py-5">Subtotal</th>
                        <th class="px-6 py-5">Discounts</th>
                        <th class="px-6 py-5">Net Sales Amount</th>
                        <th class="px-8 py-5 text-right">Payment</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50 text-xs font-semibold text-gray-700">
                    <% if(orders.length === 0) { %>
                        <tr>
                            <td colspan="7" class="text-center py-10 text-gray-400 font-bold uppercase tracking-wider">No matching transactions found.</td>
                        </tr>
                    <% } else { %>
                        <% orders.forEach(o => { %>
                            <tr class="hover:bg-gray-50/50 transition-colors">
                                <td class="px-8 py-5 text-blue-500 font-bold"><%= o.orderId %></td>
                                <td class="px-6 py-5 text-gray-400"><%= o.createdAt.toLocaleDateString() %></td>
                                <td class="px-6 py-5 text-gray-800"><%= o.shippingAddress.fullName %></td>
                                <td class="px-6 py-5 text-gray-900">₹<%= o.subtotal.toLocaleString() %></td>
                                <td class="px-6 py-5 text-rose-500">-₹<%= o.discount.toLocaleString() %></td>
                                <td class="px-6 py-5 text-emerald-600 font-extrabold">₹<%= o.grandTotal.toLocaleString() %></td>
                                <td class="px-8 py-5 text-right"><span class="bg-gray-100 text-gray-500 px-3 py-1 rounded-full text-[9px] uppercase tracking-widest"><%= o.paymentMethod %></span></td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </section>

    </main>

</body>
</html>
