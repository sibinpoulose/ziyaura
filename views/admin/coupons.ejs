<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Coupons Management | ZIYAURA Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body {
            font-family: 'Inter', sans-serif;
            background-color: #F3F6F9;
        }
        .custom-shadow {
            box-shadow: 0 2px 15px rgba(0,0,0,0.03);
        }
    </style>
</head>
<body class="flex min-h-screen">

    <%- include("../partials/admin/navbar")%>

    <!-- Main Content -->
    <main class="ml-64 flex-grow p-10">
        
        <!-- Header -->
        <header class="flex justify-between items-center mb-10">
            <div>
                <h2 class="text-2xl font-bold text-gray-800">Coupons Management</h2>
                <p class="text-xs text-gray-400 font-medium mt-1">Create, validate, and manage user discount coupons</p>
            </div>
            <button onclick="toggleForm()" class="bg-blue-500 hover:bg-blue-600 text-white font-bold text-xs uppercase px-4 py-2.5 rounded-lg tracking-widest transition-all">
                <i class="fa-solid fa-plus mr-1.5"></i> Add Coupon
            </button>
        </header>

        <!-- Search Bar Section -->
        <section class="bg-white p-5 rounded-2xl custom-shadow mb-6">
            <form action="/admin/coupons" method="GET" class="flex gap-4 items-center">
                <div class="relative flex-grow">
                    <input type="text" name="search" value="<%= typeof search !== 'undefined' ? search : '' %>" placeholder="Search coupon code or discount type..." class="w-full pl-10 pr-4 py-2.5 border border-gray-200 rounded-xl text-xs focus:outline-none focus:border-blue-500">
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3.5 text-gray-400 text-xs"></i>
                </div>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs px-6 py-2.5 rounded-xl uppercase tracking-wider transition-colors">
                    Search
                </button>
                <% if (typeof search !== 'undefined' && search) { %>
                    <a href="/admin/coupons" class="bg-gray-100 hover:bg-gray-200 text-gray-600 font-bold text-xs px-5 py-2.5 rounded-xl uppercase tracking-wider transition-colors">
                        Clear
                    </a>
                <% } %>
            </form>
        </section>

        <!-- Create/Edit Coupon Form Section (Collapsible) -->
        <section id="couponForm" class="bg-white p-8 rounded-2xl custom-shadow mb-8 hidden">
            <h4 id="formTitle" class="text-sm font-bold text-gray-800 mb-6">Create New Coupon</h4>
            <form onsubmit="event.preventDefault(); submitCoupon();" class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <input type="hidden" id="couponId">
                <div class="space-y-2">
                    <label class="block text-[10px] font-bold text-gray-400 tracking-wider uppercase">Coupon Code</label>
                    <input type="text" id="code" class="w-full border border-gray-200 text-xs px-3 py-2.5 focus:outline-none focus:border-blue-500 rounded-lg uppercase">
                </div>
                <div class="space-y-2">
                    <label class="block text-[10px] font-bold text-gray-400 tracking-wider uppercase">Discount Type</label>
                    <select id="discountType" class="w-full border border-gray-200 text-xs px-3 py-2.5 focus:outline-none focus:border-blue-500 rounded-lg bg-white">
                        <option value="percentage">Percentage (%)</option>
                        <option value="fixed">Fixed Amount (₹)</option>
                    </select>
                </div>
                <div class="space-y-2">
                    <label class="block text-[10px] font-bold text-gray-400 tracking-wider uppercase">Discount Value</label>
                    <input type="number" id="discountValue" min="0" class="w-full border border-gray-200 text-xs px-3 py-2 focus:outline-none focus:border-blue-500 rounded-lg">
                </div>
                <div class="space-y-2">
                    <label class="block text-[10px] font-bold text-gray-400 tracking-wider uppercase">Min Purchase Limit (₹)</label>
                    <input type="number" id="minPurchase" value="0" min="0" class="w-full border border-gray-200 text-xs px-3 py-2 focus:outline-none focus:border-blue-500 rounded-lg">
                </div>
                <div class="space-y-2">
                    <label class="block text-[10px] font-bold text-gray-400 tracking-wider uppercase">Max Discount Cap (₹)</label>
                    <input type="number" id="maxDiscount" class="w-full border border-gray-200 text-xs px-3 py-2 focus:outline-none focus:border-blue-500 rounded-lg" placeholder="Only for percentage type">
                </div>
                <div class="space-y-2">
                    <label class="block text-[10px] font-bold text-gray-400 tracking-wider uppercase">Expiry Date</label>
                    <input type="date" id="expiryDate" class="w-full border border-gray-200 text-xs px-3 py-2 focus:outline-none focus:border-blue-500 rounded-lg">
                </div>
                <div class="space-y-2">
                    <label class="block text-[10px] font-bold text-gray-400 tracking-wider uppercase">Total Usage Limit</label>
                    <input type="number" id="usageLimit" class="w-full border border-gray-200 text-xs px-3 py-2 focus:outline-none focus:border-blue-500 rounded-lg" placeholder="Optional">
                </div>
                <div class="md:col-span-3 flex justify-end gap-3 pt-4 border-t border-gray-50 text-[10px] font-bold tracking-widest uppercase">
                    <button type="button" onclick="toggleForm(true)" class="bg-gray-100 text-gray-600 px-6 py-3 rounded-lg hover:bg-gray-200">Cancel</button>
                    <button type="submit" id="submitBtn" class="bg-blue-500 text-white px-6 py-3 rounded-lg hover:bg-blue-600">Save Coupon</button>
                </div>
            </form>
        </section>

        <!-- Coupon Listing Table -->
        <section class="bg-white rounded-2xl custom-shadow overflow-hidden">
            <table class="w-full text-left">
                <thead>
                    <tr class="text-[11px] font-bold text-gray-400 border-b border-gray-50 uppercase tracking-wider">
                        <th class="px-8 py-5">Code</th>
                        <th class="px-6 py-5">Discount</th>
                        <th class="px-6 py-5">Min Purchase</th>
                        <th class="px-6 py-5">Expiry</th>
                        <th class="px-6 py-5">Usage Count</th>
                        <th class="px-8 py-5 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50 text-xs font-semibold text-gray-700">
                    <% if (coupons.length === 0) { %>
                        <tr>
                            <td colspan="6" class="text-center py-10 text-gray-400 uppercase tracking-wider">No coupons created yet.</td>
                        </tr>
                    <% } else { %>
                        <% coupons.forEach(c => { 
                            const isExpired = new Date() > new Date(c.expiryDate);
                        %>
                            <tr class="hover:bg-gray-50/50 transition-colors">
                                <td class="px-8 py-5 text-blue-500 font-bold"><%= c.code %></td>
                                <td class="px-6 py-5 text-gray-900">
                                    <%= c.discountType === 'percentage' ? c.discountValue + '%' : '₹' + c.discountValue %>
                                    <% if (c.maxDiscount) { %> <p class="text-[10px] text-gray-400">Cap: ₹<%= c.maxDiscount %></p> <% } %>
                                </td>
                                <td class="px-6 py-5">₹<%= c.minPurchase %></td>
                                <td class="px-6 py-5 <%= isExpired ? 'text-rose-500 font-bold' : 'text-gray-400' %>">
                                    <%= new Date(c.expiryDate).toLocaleDateString() %>
                                    <% if (isExpired) { %> (EXPIRED) <% } %>
                                </td>
                                <td class="px-6 py-5 text-gray-500"><%= c.usedCount %> <%= c.usageLimit ? '/ ' + c.usageLimit : '' %></td>
                                <td class="px-8 py-5 text-right">
                                    <button onclick='editCoupon(<%- JSON.stringify(c) %>)' class="text-blue-500 hover:text-blue-700 transition-colors font-bold text-[10px] uppercase tracking-widest mr-3"><i class="fa-solid fa-pen-to-square text-sm mr-1"></i> Edit</button>
                                    <button onclick="deleteCoupon('<%= c._id %>')" class="text-rose-500 hover:text-rose-700 transition-colors font-bold text-[10px] uppercase tracking-widest"><i class="fa-solid fa-trash-can text-sm mr-1"></i> Delete</button>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>

            <!-- Pagination -->
            <% if (typeof totalPages !== 'undefined') { %>
                <div class="flex justify-center items-center gap-3 py-6 border-t border-gray-50">
                    <% for(let i = 1; i <= totalPages; i++){ %>
                        <a
                            href="/admin/coupons?page=<%= i %>&search=<%= typeof search !== 'undefined' ? search : '' %>"
                            class="px-4 py-2 rounded-lg text-xs font-bold <%= currentPage === i ? 'bg-black text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300' %>"
                        >
                            <%= i %>
                        </a>
                    <% } %>
                </div>
            <% } %>
        </section>

    </main>

    <script>
        function toggleForm(reset = false) {
            const form = document.getElementById('couponForm');
            if (reset) {
                document.getElementById('couponId').value = '';
                document.getElementById('code').value = '';
                document.getElementById('discountType').value = 'percentage';
                document.getElementById('discountValue').value = '';
                document.getElementById('minPurchase').value = '0';
                document.getElementById('maxDiscount').value = '';
                document.getElementById('expiryDate').value = '';
                document.getElementById('usageLimit').value = '';
                document.getElementById('formTitle').innerText = 'Create New Coupon';
                document.getElementById('submitBtn').innerText = 'Save Coupon';
            }
            form.classList.toggle('hidden');
        }

        function editCoupon(c) {
            document.getElementById('couponId').value = c._id;
            document.getElementById('code').value = c.code || '';
            document.getElementById('discountType').value = c.discountType || 'percentage';
            document.getElementById('discountValue').value = c.discountValue || '';
            document.getElementById('minPurchase').value = c.minPurchase || 0;
            document.getElementById('maxDiscount').value = c.maxDiscount || '';
            if (c.expiryDate) {
                document.getElementById('expiryDate').value = new Date(c.expiryDate).toISOString().split('T')[0];
            } else {
                document.getElementById('expiryDate').value = '';
            }
            document.getElementById('usageLimit').value = c.usageLimit || '';
            
            document.getElementById('formTitle').innerText = 'Edit Coupon';
            document.getElementById('submitBtn').innerText = 'Update Coupon';

            const form = document.getElementById('couponForm');
            form.classList.remove('hidden');
            form.scrollIntoView({ behavior: 'smooth' });
        }

        function submitCoupon() {
            const couponId = document.getElementById('couponId').value;
            const code = document.getElementById('code').value.trim();
            const discountType = document.getElementById('discountType').value;
            const discountValue = document.getElementById('discountValue').value;
            const minPurchase = document.getElementById('minPurchase').value;
            const maxDiscount = document.getElementById('maxDiscount').value;
            const expiryDate = document.getElementById('expiryDate').value;
            const usageLimit = document.getElementById('usageLimit').value;

            if (!code || !discountType || !discountValue || !expiryDate) {
                return Swal.fire({ title: 'Validation Error', text: 'Please fill all required fields.', icon: 'warning' });
            }

            const selectedExpDate = new Date(expiryDate);
            const todayZero = new Date();
            todayZero.setHours(0, 0, 0, 0);

            if (isNaN(selectedExpDate.getTime())) {
                return Swal.fire({ title: 'Validation Error', text: 'Please select a valid expiry date.', icon: 'warning' });
            }

            if (selectedExpDate < todayZero) {
                return Swal.fire({ title: 'Validation Error', text: 'Coupon expiry date cannot be in the past.', icon: 'warning' });
            }

            const val = parseFloat(discountValue);
            const minP = parseFloat(minPurchase) || 0;

            if (isNaN(val) || val <= 0) {
                return Swal.fire({ title: 'Validation Error', text: 'Discount value must be greater than zero.', icon: 'warning' });
            }

            if (discountType === 'percentage' && val > 100) {
                return Swal.fire({ title: 'Validation Error', text: 'Percentage discount cannot exceed 100%.', icon: 'warning' });
            }

            if (val >= minP) {
                return Swal.fire({ title: 'Validation Error', text: 'Discount value should be lower than min purchase price.', icon: 'warning' });
            }

            const endpoint = couponId ? '/admin/coupons/update' : '/admin/coupons/create';
            const payload = { couponId, code, discountType, discountValue, minPurchase, maxDiscount, expiryDate, usageLimit };

            fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    Swal.fire({
                        title: 'Success!',
                        text: data.message,
                        icon: 'success',
                        confirmButtonText: 'OK'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.reload();
                        }
                    });
                } else {
                    Swal.fire({
                        title: 'Error!',
                        text: data.message,
                        icon: 'error',
                        confirmButtonText: 'OK'
                    });
                }
            })
            .catch(err => {
                console.error(err);
                Swal.fire({
                    title: 'Error!',
                    text: 'Something went wrong.',
                    icon: 'error',
                    confirmButtonText: 'OK'
                });
            });
        }

        function deleteCoupon(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch(`/admin/coupons/delete/${id}`, { method: 'DELETE' })
                    .then(res => res.json())
                    .then(data => {
                        if(data.success) {
                            Swal.fire({
                                title: 'Deleted!',
                                text: data.message,
                                icon: 'success',
                                confirmButtonText: 'OK'
                            }).then(() => {
                                window.location.reload();
                            });
                        } else {
                            Swal.fire({
                                title: 'Error!',
                                text: data.message,
                                icon: 'error',
                                confirmButtonText: 'OK'
                            });
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        Swal.fire({
                            title: 'Error!',
                            text: 'Failed to delete coupon.',
                            icon: 'error',
                            confirmButtonText: 'OK'
                        });
                    });
                }
            });
        }

        // Set minimum date picker threshold to Today
        document.addEventListener('DOMContentLoaded', () => {
            const todayStr = new Date().toISOString().split('T')[0];
            const dateInput = document.getElementById('expiryDate');
            if (dateInput) {
                dateInput.setAttribute('min', todayStr);
            }
        });
    </script>
</body>
</html>
