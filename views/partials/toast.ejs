<!-- Font Awesome stylesheet fallback to ensure icons are loaded -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<!-- Top-Right Container -->
<div id="toast-container-topright" class="fixed top-6 right-6 z-[9999] flex flex-col items-end gap-3 pointer-events-none max-w-xs md:max-w-sm w-full px-4"></div>

<!-- Center Modal Container -->
<div id="toast-container-center" class="fixed inset-0 z-[9999] flex flex-col items-center justify-center gap-4 pointer-events-none px-4 bg-black/45 backdrop-blur-[1.5px] hidden"></div>

<style>
  @keyframes slideInRight {
    0% {
      transform: translateX(110%);
      opacity: 0;
    }
    100% {
      transform: translateX(0);
      opacity: 1;
    }
  }

  @keyframes popInCenter {
    0% {
      transform: scale(0.9);
      opacity: 0;
    }
    100% {
      transform: scale(1);
      opacity: 1;
    }
  }

  @keyframes toastPopOut {
    0% {
      transform: scale(1);
      opacity: 1;
    }
    100% {
      transform: scale(0.9);
      opacity: 0;
    }
  }

  @keyframes toastProgressBar {
    0% {
      width: 100%;
    }
    100% {
      width: 0%;
    }
  }

  .toast-topright {
    animation: slideInRight 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    pointer-events: auto;
  }

  .toast-center {
    animation: popInCenter 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    pointer-events: auto;
  }

  .toast-item.toast-exit {
    animation: toastPopOut 0.25s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  }

  .toast-progress {
    animation: toastProgressBar 4s linear forwards;
  }
</style>

<script>
  function showToast(message, type = 'success', priority = 'low') {
    // We ignore 'none' priority messages (e.g. cart quantity increments)
    if (priority === 'none') return;

    let containerId = 'toast-container-topright';
    if (priority === 'high') {
      containerId = 'toast-container-center';
      const centerOverlay = document.getElementById('toast-container-center');
      if (centerOverlay) {
        centerOverlay.classList.remove('hidden');
        centerOverlay.style.pointerEvents = 'auto'; // allow click interactions on modal dismiss buttons
      }
    }

    const container = document.getElementById(containerId);
    if (!container) return;

    const toast = document.createElement('div');
    if (priority === 'high') {
      toast.className = 'toast-item toast-center relative flex flex-col items-center text-center p-8 bg-white rounded-lg shadow-2xl border border-gray-100 max-w-md w-full overflow-hidden';
    } else {
      toast.className = 'toast-item toast-topright relative flex items-center gap-4 p-4 bg-white/95 backdrop-blur-md rounded-sm shadow-md border border-gray-100/60 min-w-[280px] max-w-sm overflow-hidden';
    }

    // Icon & Color definitions
    let iconBg = '';
    let iconColor = '';
    let iconClass = '';
    let barColor = '';
    let title = '';

    if (type === 'success') {
      iconBg = 'bg-emerald-50';
      iconColor = 'text-emerald-500';
      iconClass = 'fa-solid fa-circle-check';
      barColor = 'bg-emerald-500';
      title = 'SUCCESS';
    } else {
      iconBg = 'bg-rose-50';
      iconColor = 'text-rose-500';
      iconClass = 'fa-solid fa-circle-xmark';
      barColor = 'bg-rose-500';
      title = 'ERROR';
    }

    if (priority === 'high') {
      toast.innerHTML = `
        <div class="flex items-center justify-center w-14 h-14 rounded-full mb-4 ${iconBg} ${iconColor} shadow-sm">
          <i class="${iconClass} text-2xl"></i>
        </div>
        <div class="mb-4">
          <h3 class="text-sm font-bold text-gray-900 tracking-wider">${title}</h3>
          <p class="text-xs text-gray-500 mt-2 leading-relaxed px-4 font-medium">${message}</p>
        </div>
        <button class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 transition-colors duration-150 p-1 focus:outline-none" onclick="dismissToast(this.parentElement, 'high')">
          <i class="fa-solid fa-xmark text-sm"></i>
        </button>
        <div class="absolute bottom-0 left-0 h-1 w-full ${barColor} toast-progress"></div>
      `;
    } else {
      toast.innerHTML = `
        <div class="flex items-center justify-center w-8 h-8 rounded-full flex-shrink-0 ${iconBg} ${iconColor}">
          <i class="${iconClass} text-sm"></i>
        </div>
        <div class="flex-grow pr-6 text-left">
          <p class="text-xs font-bold text-gray-800 tracking-tight uppercase">${title}</p>
          <p class="text-[10px] font-semibold text-gray-500 leading-tight mt-0.5">${message}</p>
        </div>
        <button class="absolute top-2.5 right-2 text-gray-400 hover:text-gray-600 transition-colors duration-150 p-1" onclick="dismissToast(this.parentElement, 'low')">
          <i class="fa-solid fa-xmark text-[10px]"></i>
        </button>
        <div class="absolute bottom-0 left-0 h-0.5 w-full ${barColor} toast-progress"></div>
      `;
    }

    container.appendChild(toast);

    // Auto dismiss after 4 seconds
    const timeoutId = setTimeout(() => {
      dismissToast(toast, priority);
    }, 4000);

    toast.dataset.timeoutId = timeoutId;
  }

  function dismissToast(toastElement, priority) {
    if (!toastElement || toastElement.classList.contains('toast-exit')) return;
    
    if (toastElement.dataset.timeoutId) {
      clearTimeout(parseInt(toastElement.dataset.timeoutId));
    }

    toastElement.classList.add('toast-exit');
    toastElement.addEventListener('animationend', (e) => {
      if (e.animationName === 'toastPopOut') {
        toastElement.remove();
        if (priority === 'high') {
          const centerOverlay = document.getElementById('toast-container-center');
          if (centerOverlay && centerOverlay.children.length === 0) {
            centerOverlay.classList.add('hidden');
            centerOverlay.style.pointerEvents = 'none';
          }
        }
      }
    });
  }

  // Auto trigger EJS flash messages if present
  document.addEventListener('DOMContentLoaded', () => {
    const successMsg = "<%= (typeof success !== 'undefined' && success) ? success : '' %>";
    const errorMsg = "<%= (typeof error !== 'undefined' && error) ? error : '' %>";

    // Flash messages are classified as 'low' priority top-right notifications
    if (successMsg) {
      showToast(successMsg, 'success', 'low');
    }
    if (errorMsg) {
      showToast(errorMsg, 'error', 'low');
    }
  });
</script>
