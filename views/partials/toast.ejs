<!-- Font Awesome stylesheet fallback to ensure icons are loaded -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<!-- Toast Container -->
<div id="toast-container" class="fixed inset-0 z-[9999] flex flex-col items-center justify-center gap-4 pointer-events-none px-4"></div>

<style>
  @keyframes toastPopIn {
    0% {
      transform: scale(0.85);
      opacity: 0;
    }
    70% {
      transform: scale(1.02);
      opacity: 0.95;
    }
    100% {
      transform: scale(1);
      opacity: 1;
    }
  }

  @keyframes toastPopOut {
    0% {
      transform: scale(1);
      opacity: 1;
    }
    100% {
      transform: scale(0.9);
      opacity: 0;
    }
  }

  @keyframes toastProgressBar {
    0% {
      width: 100%;
    }
    100% {
      width: 0%;
    }
  }

  .toast-item {
    animation: toastPopIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    pointer-events: auto;
  }

  .toast-item.toast-exit {
    animation: toastPopOut 0.3s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  }

  .toast-progress {
    animation: toastProgressBar 4s linear forwards;
  }
</style>

<script>
  function showToast(message, type = 'success') {
    const container = document.getElementById('toast-container');
    if (!container) return;

    // Create toast wrapper
    const toast = document.createElement('div');
    toast.className = 'toast-item relative flex flex-col items-center text-center p-6 bg-white/95 backdrop-blur-md rounded-2xl shadow-[0_20px_50px_rgba(0,0,0,0.15)] border border-gray-100 min-w-[320px] max-w-sm overflow-hidden';

    // Icon & Color definitions
    let iconBg = '';
    let iconColor = '';
    let iconClass = '';
    let barColor = '';
    let title = '';

    if (type === 'success') {
      iconBg = 'bg-emerald-50';
      iconColor = 'text-emerald-500';
      iconClass = 'fa-solid fa-circle-check';
      barColor = 'bg-emerald-500';
      title = 'Success';
    } else {
      iconBg = 'bg-rose-50';
      iconColor = 'text-rose-500';
      iconClass = 'fa-solid fa-circle-xmark';
      barColor = 'bg-rose-500';
      title = 'Error';
    }

    toast.innerHTML = `
      <div class="flex items-center justify-center w-14 h-14 rounded-full mb-3 ${iconBg} ${iconColor} shadow-sm">
        <i class="${iconClass} text-2xl"></i>
      </div>
      <div class="mb-3">
        <h3 class="text-base font-bold text-gray-800 tracking-tight">
          ${title}
        </h3>
        <p class="text-xs text-gray-500 mt-1 leading-relaxed px-2">
          ${message}
        </p>
      </div>
      <button class="absolute top-3 right-3 text-gray-400 hover:text-gray-600 transition-colors duration-150 p-1 focus:outline-none" onclick="dismissToast(this.parentElement)">
        <i class="fa-solid fa-xmark text-sm"></i>
      </button>
      <div class="absolute bottom-0 left-0 h-1 ${barColor} toast-progress"></div>
    `;

    container.appendChild(toast);

    // Auto dismiss after 4 seconds
    const timeoutId = setTimeout(() => {
      dismissToast(toast);
    }, 4000);

    toast.dataset.timeoutId = timeoutId;
  }

  function dismissToast(toastElement) {
    if (!toastElement || toastElement.classList.contains('toast-exit')) return;
    
    // Clear timeout if clicked manually
    if (toastElement.dataset.timeoutId) {
      clearTimeout(parseInt(toastElement.dataset.timeoutId));
    }

    toastElement.classList.add('toast-exit');
    toastElement.addEventListener('animationend', (e) => {
      if (e.animationName === 'toastPopOut') {
        toastElement.remove();
      }
    });
  }

  // Auto trigger EJS flash messages if present
  document.addEventListener('DOMContentLoaded', () => {
    // We parse EJS variables safely
    const successMsg = "<%= (typeof success !== 'undefined' && success) ? success : '' %>";
    const errorMsg = "<%= (typeof error !== 'undefined' && error) ? error : '' %>";

    if (successMsg) {
      showToast(successMsg, 'success');
    }
    if (errorMsg) {
      showToast(errorMsg, 'error');
    }
  });
</script>
